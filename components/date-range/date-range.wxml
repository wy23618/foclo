<view wx:if="{{opened}}" class="mask" catchtap="close" catchtouchmove="noop"></view>
<view wx:if="{{opened}}" class="sheet theme-{{theme}}" catchtouchmove="noop">
  <view class="handle"></view><view class="heading">自定义时间范围</view><view class="hint">包含开始日和结束日</view>
  <view class="dates"><picker class="date-picker" mode="date" value="{{draftStart}}" end="{{today}}" bindchange="startChange"><view class="date"><text class="date-label">开始日期</text><view class="date-value">{{draftStart}}</view></view></picker><view class="dash">—</view><picker class="date-picker" mode="date" value="{{draftEnd}}" end="{{today}}" bindchange="endChange"><view class="date"><text class="date-label">结束日期</text><view class="date-value">{{draftEnd}}</view></view></picker></view>
  <view class="error">{{error}}</view><view class="buttons"><button class="date-action-button" bindtap="close">取消</button><button class="date-action-button confirm" bindtap="confirm">查看统计</button></view>
</view>
