@import "../../themes/palette.wxss";
.mask{position:fixed;inset:0;background:rgba(30,34,30,.35);z-index:200}.sheet{position:fixed;bottom:0;left:0;right:0;z-index:201;background:var(--bg-surface-soft);padding:20rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));border-radius:40rpx 40rpx 0 0}.handle{width:64rpx;height:7rpx;border-radius:8rpx;background:var(--control-handle);margin:0 auto 28rpx}.heading{font-size:34rpx;font-weight:600;color:var(--text-control)}.hint{font-size:24rpx;color:var(--text-secondary);margin:10rpx 0 32rpx}.dates{display:flex;align-items:center;gap:16rpx}.dates .date-picker{flex:1;min-width:0}.date{background:var(--bg-input);padding:24rpx 14rpx;border-radius:20rpx;font-size:27rpx;text-align:center;font-variant-numeric:tabular-nums;color:var(--text-control)}.date-label{font-size:22rpx;color:var(--text-secondary)}.date-value{margin-top:12rpx}.dash{color:var(--text-muted)}.error{height:46rpx;font-size:24rpx;color:var(--danger-text);margin-top:14rpx}.buttons{display:flex;gap:20rpx}.buttons .date-action-button{flex:1;margin:0;border-radius:24rpx;font-size:28rpx;background:var(--action-secondary);color:var(--accent)}.buttons .date-action-button::after{border:none}.buttons .confirm{background:var(--action-primary);color:var(--text-on-accent)}

.sheet{top:50%;bottom:auto;left:6%;right:6%;transform:translateY(-50%);border-radius:28rpx;padding:36rpx 28rpx}.handle{display:none}
