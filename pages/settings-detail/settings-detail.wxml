<page-meta page-style="{{themePageStyle}}"/>
<view class="container settings-page theme-{{themeClass}}">
  <view wx:if="{{loading}}" class="loading">正在读取本机设置…</view>
  <view wx:elif="{{page === 'focus'}}" class="detail-content">
    <view class="detail-note">设置会自动保存，下次专注时生效。</view>
    <view class="setting-card detail-card">
      <view class="setting-row" data-row="计时习惯" bindtap="onRow"><view class="row-copy"><text class="row-title">开始时使用</text></view><text class="row-value">{{prefs.startupMode === 'remember' ? '上次模式' : (prefs.startupMode === 'countdown' ? '倒计时' : '正向计时')}}</text><view class="chevron"></view></view>
      <picker mode="selector" range="{{minuteOptions}}" value="{{defaultMinuteIndex}}" bindchange="selectDefaultMinutes"><view class="setting-row"><view class="row-copy"><text class="row-title">默认倒计时</text></view><text class="row-value">{{prefs.defaultMinutes}} 分钟</text><view class="chevron chevron-down"></view></view></picker>
      <view class="preset-editor"><view class="row-title">常用时长</view><view class="row-summary">点下方数字修改</view><view class="preset-pickers"><picker wx:for="{{commonIndexes}}" wx:key="*this" mode="selector" range="{{minuteOptions}}" value="{{item}}" data-index="{{index}}" bindchange="selectCommonMinutes"><view class="preset-choice">{{prefs.commonMinutes[index]}}<text> 分</text></view></picker></view></view>
      <view class="setting-row" data-row="结束确认" bindtap="onRow"><view class="row-copy"><text class="row-title">结束前确认</text></view><view class="toggle {{prefs.confirmEnd ? 'toggle-on' : ''}}"><view class="toggle-dot"></view></view></view>
      <view class="setting-row" data-row="休息安排" bindtap="onRow"><view class="row-copy"><text class="row-title">专注后休息</text><text class="row-summary">完成一轮专注后提示休息</text></view><view class="toggle {{prefs.restEnabled ? 'toggle-on' : ''}}"><view class="toggle-dot"></view></view></view>
      <view wx:if="{{prefs.restEnabled}}" class="break-options">
        <view class="break-option"><text>短休息</text><picker mode="selector" range="{{shortOptions}}" value="{{prefs.shortBreakMinutes - 1}}" data-key="shortBreakMinutes" bindchange="selectBreak"><view class="option-select">{{prefs.shortBreakMinutes}} 分钟<view class="select-down"></view></view></picker></view>
        <view class="break-option"><text>长休息</text><picker mode="selector" range="{{longOptions}}" value="{{prefs.longBreakMinutes - 1}}" data-key="longBreakMinutes" bindchange="selectBreak"><view class="option-select">{{prefs.longBreakMinutes}} 分钟<view class="select-down"></view></view></picker></view>
        <view class="break-option"><text>长休息间隔</text><picker mode="selector" range="{{cycleOptions}}" value="{{prefs.longBreakEvery - 2}}" data-key="longBreakEvery" data-offset="2" bindchange="selectBreak"><view class="option-select">每 {{prefs.longBreakEvery}} 轮<view class="select-down"></view></view></picker></view>
      </view>
    </view>
  </view>
  <view wx:elif="{{page === 'display'}}" class="detail-content">
    <view class="setting-card detail-card">
      <view class="theme-options">
        <view class="theme-choice {{prefs.theme === 'system' ? 'theme-choice-on' : ''}}" data-theme="system" bindtap="selectTheme">
          <view class="theme-preview theme-preview-system"><view class="preview-half theme-{{prefs.lightTheme}}"></view><view class="preview-half preview-dark"></view><view class="preview-card"></view></view>
          <view class="theme-choice-copy"><text class="theme-choice-name">跟随系统</text><text wx:if="{{prefs.theme === 'system'}}" class="theme-check">✓</text></view>
        </view>
        <view class="theme-choice {{prefs.theme === 'light' ? 'theme-choice-on' : ''}}" data-theme="light" bindtap="selectTheme">
          <view class="theme-preview theme-{{prefs.lightTheme}}"><view class="preview-card"></view><view class="preview-line"></view></view>
          <view class="theme-choice-copy"><text class="theme-choice-name">浅色</text><text wx:if="{{prefs.theme === 'light'}}" class="theme-check">✓</text></view>
        </view>
        <view class="theme-choice {{prefs.theme === 'dark' ? 'theme-choice-on' : ''}}" data-theme="dark" bindtap="selectTheme">
          <view class="theme-preview theme-preview-dark"><view class="preview-card"></view><view class="preview-line"></view></view>
          <view class="theme-choice-copy"><text class="theme-choice-name">深色</text><text wx:if="{{prefs.theme === 'dark'}}" class="theme-check">✓</text></view>
        </view>
      </view>
      <view class="light-palette-row">
        <text class="light-palette-title">浅色配色</text>
        <view class="light-palette-options">
          <view wx:for="{{lightThemes}}" wx:key="id" class="light-palette-choice {{prefs.lightTheme === item.id ? 'light-palette-choice-on' : ''}}" data-light-theme="{{item.id}}" catchtap="selectLightTheme"><view class="palette-preview theme-{{item.id}}"><view class="palette-swatch palette-page"></view><view class="palette-swatch palette-card"></view><view class="palette-swatch palette-soft"></view><view class="palette-swatch palette-accent"></view></view><text>{{item.name}}</text></view>
        </view>
      </view>
      <view class="setting-row" data-row="屏幕常亮" bindtap="onRow"><view class="row-copy"><text class="row-title">专注时屏幕常亮</text></view><view class="toggle {{prefs.keepScreenOn ? 'toggle-on' : ''}}"><view class="toggle-dot"></view></view></view>
    </view>
    <view class="display-tip"><view class="display-tip-title">专注时还能这样操作</view><view>点「极简显示」只看计时。</view><view>点「防误触」进入，长按屏幕解除。</view></view>
  </view>
  <view wx:elif="{{page === 'stats'}}" class="detail-content">
    <view class="setting-card detail-card">
      <view class="setting-row" data-row="统计默认范围" bindtap="onRow"><view class="row-copy"><text class="row-title">打开统计时显示</text></view><text class="row-value">{{prefs.statsPreset === 'today' ? '今日' : (prefs.statsPreset === 'last7' ? '近 7 天' : '近 30 天')}}</text><view class="chevron"></view></view>
      <view class="setting-row" data-row="显示今日目标" bindtap="onRow"><view class="row-copy"><text class="row-title">显示今日目标</text><text class="row-summary">在专注页和统计页显示</text></view><view class="toggle {{prefs.dailyGoalEnabled ? 'toggle-on' : ''}}"><view class="toggle-dot"></view></view></view>
      <picker wx:if="{{prefs.dailyGoalEnabled}}" mode="selector" range="{{minuteOptions}}" value="{{prefs.dailyGoalMinutes - 1}}" bindchange="selectGoalMinutes"><view class="setting-row"><view class="row-copy"><text class="row-title">每日目标时长</text></view><text class="row-value">{{prefs.dailyGoalMinutes}} 分钟</text><view class="chevron chevron-down"></view></view></picker>
      <view class="setting-row" data-row="每周起始日" bindtap="onRow"><view class="row-copy"><text class="row-title">每周从</text></view><text class="row-value">{{prefs.weekStartsSunday ? '周日开始' : '周一开始'}}</text><view class="chevron"></view></view>
    </view>
  </view>
  <view wx:elif="{{page === 'data'}}" class="detail-content">
    <view class="data-note">{{hasAccount ? '当前使用微信账号记录。更改先存在这台设备，联网后自动保存到账号。' : '当前使用游客记录，仅保存在这台设备。登录后可选择保存到账号。'}}</view>
    <view class="setting-card detail-card">
      <view class="setting-row" data-row="备份本机数据" bindtap="onRow"><view class="row-copy"><text class="row-title">保存一份备份</text><text class="row-summary">{{hasAccount ? '备份当前账号在这台设备上的项目和记录' : '备份这台设备的游客项目和记录'}}</text></view><view class="chevron"></view></view>
      <view class="setting-row" data-row="从备份恢复" bindtap="onRow"><view class="row-copy"><text class="row-title">从备份找回记录</text><text class="row-summary">选择以前保存的 YoTick 备份文件</text></view><view class="chevron"></view></view>
    </view>
    <view class="detail-group-title" bindtap="toggleMoreData">其他操作 {{moreDataOpen ? '−' : '+'}}</view>
    <block wx:if="{{moreDataOpen}}">
      <view class="setting-card detail-card">
        <view class="setting-row" data-row="导出统计表" bindtap="onRow"><view class="row-copy"><text class="row-title">保存统计表格</text><text class="row-summary">用于查看和分析，不能用来恢复记录</text></view><view class="chevron"></view></view>
        <view class="setting-row" data-row="恢复默认设置" bindtap="onRow"><view class="row-copy"><text class="row-title">恢复默认设置</text><text class="row-summary">只重置偏好设置，保留项目和记录</text></view><view class="chevron"></view></view>
        <view wx:if="{{!hasAccount}}" class="setting-row danger-row" data-row="清空全部数据" bindtap="onRow"><view class="row-copy"><text class="row-title">清空游客记录</text><text class="row-summary">只删除这台设备上的游客记录</text></view><view class="chevron"></view></view>
        <view wx:if="{{hasAccount}}" class="setting-row" data-row="数据维护" bindtap="onRow"><view class="row-copy"><text class="row-title">账号数据与注销</text><text class="row-summary">删除全部记录、申请注销账号</text></view><view class="chevron"></view></view>
      </view>
    </block>
  </view>
  <view wx:elif="{{page === 'help'}}" class="detail-content">
    <view class="setting-card detail-card">
      <view class="setting-row" data-row="使用帮助" bindtap="onRow"><view class="row-copy"><text class="row-title">使用指南</text><text class="row-summary">专注、项目、统计与数据保存</text></view><view class="chevron"></view></view>
      <view class="setting-row" data-row="复制反馈信息" bindtap="onRow"><view class="row-copy"><text class="row-title">复制反馈信息</text><text class="row-summary">设备和版本信息，不含项目与专注记录</text></view><view class="chevron"></view></view>
      <view class="setting-row" data-row="关于 YoTick" bindtap="onRow"><view class="row-copy"><text class="row-title">关于 YoTick</text><text class="row-summary">版本 {{appVersion || '以当前构建为准'}} · 本机数据说明</text></view><view class="chevron"></view></view>
    </view>
  </view>
</view>
