/* pages/focus/focus.wxss */
.guest-hint { margin:24rpx 0 0; padding:22rpx 26rpx; border-radius:24rpx; background:var(--bg-card, #fff); border:1rpx solid var(--border, #e2e8dc); text-align:left; }
.guest-hint-copy { display:flex; flex-direction:column; gap:8rpx; }
.guest-hint-title { font-size:24rpx; font-weight:500; color:var(--text-primary, #293326); }
.guest-hint-description { font-size:21rpx; line-height:1.6; color:var(--text-secondary, #75806F); }
.guest-hint-actions { display:flex; align-items:center; justify-content:space-between; margin-top:10rpx; }
.guest-hint-login { margin:0!important; padding:8rpx 0!important; background:transparent; color:var(--accent, #526C42); font-size:23rpx; line-height:1.5; }
.guest-hint-login text { margin-left:8rpx; }
.guest-hint-close { margin:0 -12rpx 0 0!important; padding:4rpx 12rpx!important; background:transparent; color:var(--text-secondary, #75806F); font-size:32rpx; line-height:1.3; }
.guest-hint-login::after,.guest-hint-close::after { border:0; }

/* ---------------- 顶部品牌与统计入口 ---------------- */
.top-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 6rpx 10rpx 0;
}

.top-brand {
  display: flex;
  align-items: center;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-secondary);
}

.top-brand-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 999rpx;
  background: var(--accent);
  margin-right: 12rpx;
}

.top-stats {
  font-size: 26rpx;
  color: var(--accent);
  font-weight: 600;
  padding: 8rpx 4rpx;
}

.top-stats:active { opacity: 0.6; }

/* ---------------- 状态与项目头 ---------------- */
.proj-head {
  padding: 12rpx 8rpx 28rpx;
  text-align: center;
}

.status-pill {
  display: inline-flex;
  align-items: center;
  background: var(--bg-control-soft);
  border-radius: 999rpx;
  padding: 10rpx 26rpx;
  font-size: 24rpx;
  font-weight: 500;
  color: var(--text-secondary);
}

.status-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 999rpx;
  background: var(--accent);
  margin-right: 12rpx;
}

.proj-line {
  margin-top: 22rpx;
  display: flex;
  align-items: baseline;
  justify-content: center;
  min-height: 68rpx;
}

.proj-name {
  font-size: 48rpx;
  font-weight: 700;
  color: var(--text-primary);
  max-width: 520rpx;
}

.proj-placeholder {
  font-size: 42rpx;
  font-weight: 600;
  color: var(--text-muted);
}

.proj-caret {
  color: var(--text-muted);
  font-size: 36rpx;
  margin-left: 14rpx;
}

.proj-sub { margin-top: 12rpx; }

/* ---------------- 圆形表盘（固定尺寸，数字更新不跳动） ---------------- */
.dial {
  position: relative;
  width: 560rpx;
  height: 560rpx;
  margin: 4rpx auto 32rpx;
  background: var(--bg-card);
  border: 1rpx solid var(--border);
  border-radius: 999rpx;
  box-shadow: 0 4rpx 16rpx rgba(61, 90, 64, 0.04), 0 2rpx 4rpx rgba(30, 34, 30, 0.02);
  display: flex;
  align-items: center;
  justify-content: center;
}

.dial-dash {
  position: absolute;
  inset: 26rpx;
  border: 2rpx dashed var(--border);
  border-radius: 999rpx;
}

.dial-nub {
  position: absolute;
  top: 16rpx;
  left: 50%;
  width: 6rpx;
  height: 14rpx;
  margin-left: -3rpx;
  background: var(--accent);
  border-radius: 4rpx;
}

.dial-inner {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 0 40rpx;
}

.dial-modepill {
  display: inline-flex;
  align-items: center;
  background: var(--bg-control-soft);
  border-radius: 999rpx;
  padding: 8rpx 22rpx;
  font-size: 22rpx;
  color: var(--text-secondary);
  margin-bottom: 18rpx;
}

.dial-mode-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 999rpx;
  background: var(--accent);
  margin-right: 10rpx;
}

.dial-num {
  font-size: 104rpx;
  font-weight: 700;
  color: var(--text-primary);
  line-height: 1.1;
  letter-spacing: 2rpx;
}

.dial-num-paused { color: var(--text-muted); }

.dial-cap {
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-top: 10rpx;
}

.dial-meta {
  font-size: 22rpx;
  color: var(--text-muted);
  margin-top: 14rpx;
  text-align: center;
}

/* ---------------- 模式与时长控件 ---------------- */
.ctl { margin-bottom: 24rpx; }

.preset-scroll {
  white-space: nowrap;
  margin-bottom: 28rpx;
}

.presets {
  display: flex;
  gap: 16rpx;
  padding: 4rpx 32rpx 4rpx 2rpx;
}

.preset {
  flex-shrink: 0;
  padding: 16rpx 30rpx;
  border-radius: 999rpx;
  background: var(--bg-card);
  border: 1rpx solid var(--border);
  color: var(--text-secondary);
  font-size: 26rpx;
  font-weight: 500;
}

.preset-on {
  background: var(--accent);
  border-color: var(--accent);
  color: var(--bg-page);
  font-weight: 600;
  box-shadow: 0 6rpx 16rpx rgba(61, 90, 64, 0.16);
}

/* ---------------- 操作按钮 ---------------- */
.actions { margin-top: 4rpx; }

.two-col { display: flex; gap: 20rpx; }
.two-col .btn { flex: 1; }

.anomaly { background: var(--warning-bg); }

/* ---------------- 页内项目选择覆盖层 ---------------- */
.pk-screen {
  position: fixed;
  inset: 0;
  background: var(--bg-page);
  z-index: 50;
  display: flex;
  flex-direction: column;
  height: 100vh;
}

.pk-header {
  display: flex;
  align-items: center;
  height: 88rpx;
  flex-shrink: 0;
  background: var(--bg-card);
  border-bottom: 1rpx solid var(--border);
}

.pk-back {
  width: 150rpx;
  color: var(--accent);
  padding-left: 24rpx;
  font-size: 28rpx;
}

.pk-header-title {
  flex: 1;
  text-align: center;
  font-weight: 600;
  font-size: 30rpx;
}

.pk-header-right { width: 150rpx; }

.pk-body {
  flex: 1;
  box-sizing: border-box;
  padding: 24rpx 32rpx;
}

.pk-bottom-space { height: 60rpx; }

.pk-input { margin-bottom: 16rpx; }
.pk-parent { margin-bottom: 8rpx; }
.pk-hint { display: block; margin-bottom: 20rpx; }
.pk-empty { padding: 24rpx 0; }

.pk-row {
  display: flex;
  align-items: center;
  padding: 22rpx 16rpx;
  border-radius: 16rpx;
}

.pk-row:active { background: var(--bg-control-soft); }

.pk-main {
  flex: 1;
  display: flex;
  align-items: center;
  min-width: 0;
}

.pk-icon {
  margin-right: 12rpx;
  color: var(--text-muted);
}

.pk-setparent {
  flex-shrink: 0;
  margin-left: 16rpx;
  padding: 10rpx 20rpx;
  font-size: 22rpx;
  color: var(--accent);
  border: 1rpx solid var(--accent);
  border-radius: 999rpx;
}

.pk-setparent:active { background: var(--accent-soft); }

