<page-meta page-style="{{themePageStyle}}"/>
<safe-nav id="safeNav" theme="{{themeClass}}" title="{{name}}统计" back-text="‹ 全部统计" refresh="{{true}}" hidden="{{rangeOpen || chartFull}}" bindback="back" bindrefresh="refresh" bindheightchange="onNavHeightChange"/>
<view class="container theme-{{themeClass}}">
  <view class="stats-sticky-controls" style="top:{{filterTop}}px">
    <button class="subject-entry" catchtap="openSubjects" hover-class="subject-entry-pressed"><text>当前统计：{{name}}</text><text>切换 ▾</text></button>
    <view class="filter-row"><view class="flex-1"><segmented id="rangeTabs" items="{{rangeItems}}" selected="{{preset}}" bindchange="onRangeChange"/></view><view class="heat-btn" bindtap="goHeatmap"><view class="heat-grid"><view wx:for="{{[1,2,3,4,5,6,7,8,9]}}" wx:key="*this" class="hg-dot"></view></view><text class="heat-label">热力图</text></view></view>
  </view>
  <view class="project-crumb">{{pathText}}</view>
  <view wx:if="{{preset === 'custom'}}" class="range-edit" bindtap="openRange">{{rangeText}} 修改 ▾</view>
  <view wx:if="{{error}}" class="card error-card"><view>{{error}}</view><button class="btn btn-ghost btn-sm mt-sm" bindtap="refresh">重新读取</button></view>
  <view class="card summary-card">
    <view class="summary-head"><view class="project-summary-title"><view class="project-color-dot" style="background:{{projectColor}}"></view><text class="summary-head-title">{{name}}</text></view><text class="summary-date">{{loading ? '正在更新…' : rangeText}}</text></view>
    <view class="summary-well"><view class="summary-kicker">专注总时长</view><view class="summary-time num"><block wx:if="{{sumZero}}"><text class="summary-time-number">0</text><text class="summary-time-unit">秒</text></block><block wx:else><text wx:if="{{sumH}}" class="summary-time-number">{{sumH}}</text><text wx:if="{{sumH}}" class="summary-time-unit">小时</text><text wx:if="{{sumM}}" class="summary-time-number">{{sumM}}</text><text wx:if="{{sumM}}" class="summary-time-unit">分钟</text><text wx:if="{{!sumH && sumS}}" class="summary-time-number">{{sumS}}</text><text wx:if="{{!sumH && sumS}}" class="summary-time-unit">秒</text></block></view></view>
    <view class="summary-metrics">
      <view class="summary-metric"><view class="summary-metric-label">专注次数</view><view class="summary-metric-value">{{focusCount}}<text class="summary-metric-unit">次</text></view></view>
      <view class="summary-metric"><view class="summary-metric-label">暂停次数</view><view class="summary-metric-value">{{pauseCount}}<text class="summary-metric-unit">次</text></view></view>
      <view wx:if="{{preset === 'today'}}" class="summary-metric"><view class="summary-metric-label">平均单次</view><view class="summary-metric-value summary-metric-value-average">{{avgSessionText}}</view></view>
      <view wx:else class="summary-metric"><view class="summary-metric-label">日均专注</view><view class="summary-metric-value summary-metric-value-average">{{avgDisplay}}</view></view>
    </view>
  </view>
  <view wx:if="{{showDistributionChart}}" class="card distribution-card"><view class="distribution-header"><view class="distribution-heading"><view class="title-sm">时间分配</view><text class="distribution-hint">点图表可定位对应学习内容</text></view><view class="chart-tools"><view wx:if="{{chartExpandable}}" class="chart-action" hover-class="chart-action-pressed" bindtap="toggleChartAll">{{chartAllExpanded ? '收起全部' : '展开全部'}}</view><view class="chart-action" hover-class="chart-action-pressed" bindtap="goHierarchy"><view class="fullscreen-icon"><view class="fullscreen-corner tl"></view><view class="fullscreen-corner tr"></view><view class="fullscreen-corner bl"></view><view class="fullscreen-corner br"></view></view><text>查看大图</text></view></view></view><stat-donut id="distributionChart" groups="{{chartGroups}}" segments="{{distRows}}" tree="{{chartTree}}" theme="{{themeClass}}" total-text="{{shortTotal}}" center-label="{{name}}" single-expand="{{true}}" compact="{{true}}" toolbar-actions="{{true}}" obscured="{{chartObscured}}" bindexpandstate="onChartExpandState" bindselectParent="onChartSelectParent" bindselectChild="onChartSelectChild" bindfullchange="onChartFullChange"/></view>
  <project-list wx:if="{{chartTree.length}}" id="projectList" title="学习内容" tree="{{chartTree}}" selected-id="{{selectedProjectId}}" range-key="{{projectId}}:{{preset}}:{{startDate}}:{{endDate}}" bindselect="drill" bindfocuschange="onListFocusChange" bindclearfocus="clearProjectFocus"/>
  <view wx:elif="{{listRows.length}}" class="card project-tree-card"><view class="row-between"><view class="title-sm">学习内容</view><text class="muted tiny">点项目展开 · 点统计查看</text></view><subject-tree id="subjectTree" rows="{{listRows}}" selected-id="{{selectedProjectId}}" bindselect="drill"/></view>
  <view wx:if="{{preset !== 'today'}}" class="card"><view class="title-sm">每日专注时长</view><view class="chart-hint">向左滑动查看更早日期 · 点击查看当天统计</view><daily-bars id="dailyBars" series="{{dailySeries}}" bindselect="selectDay"/></view>
  <view class="card time-slot-card">
    <view class="row-between"><view class="title-sm">专注时段分布</view><picker range="{{slotScaleOptions}}" value="{{slotScaleIndex}}" bindchange="selectSlotScale"><view class="slot-scale-picker">满格 {{slotScaleFixed ? slotScaleText : '自动'}} ▾</view></picker></view>
    <view class="chart-hint">每柱代表 1 小时 · 按所选范围内自然日平均</view>
    <view class="time-slot-chart">
      <view wx:for="{{timeSlots}}" wx:key="startHour" class="time-slot-column" data-index="{{index}}" bindtap="selectTimeSlot">
        <view class="time-slot-plot"><view class="time-slot-fill {{selectedTimeSlot === index ? 'time-slot-selected' : ''}} {{item.overScale ? 'time-slot-over' : ''}}" style="height:{{item.height}}%"></view></view>
        <view class="time-slot-axis">{{item.axisLabel}}</view>
      </view>
    </view>
    <view class="time-slot-detail" wx:if="{{selectedSlot}}">{{selectedSlot.label}} · 日均 {{selectedSlot.averageText}}{{selectedSlot.overScale ? ' · 超出满格' : ''}}</view>
  </view>
  <view wx:if="{{preset === 'today'}}" class="day-records"><day-detail id="dayDetail" summary="{{false}}" distribution="{{false}}" date="{{selectedDate}}" controls="{{false}}" scope="{{projectId}}" mode="{{mode}}" start="{{rangeStart}}" end="{{rangeEnd}}" binddatechange="selectDay" bindrecorddeleted="load"/></view>
</view>
<date-range theme="{{themeClass}}" id="dateRange" opened="{{rangeOpen}}" start="{{startDate}}" end="{{endDate}}" bindclose="closeRange" bindconfirm="confirmRange"/>
<subject-picker id="subjectPicker" opened="{{scopeOpen}}" rows="{{subjectOptions}}" selected="{{projectId}}" theme="{{themeClass}}" bindclose="closeSubjects" bindafterclose="onSubjectsAfterClose" bindselect="chooseSubject"/>
<heatmap-card opened="{{heatmapOpen}}" scope-id="{{projectId}}" theme="{{themeClass}}" top-inset="{{filterTop}}" bindclose="closeHeatmap"/>
