.focus-stage .dial-num-stopwatch.dial-num-wide{font-size:64rpx}
.focus-stage .dial-cap{font-size:25rpx;margin-top:20rpx}
.focus-stage .run-footer{margin:20rpx 0 0;font-size:25rpx;line-height:1.5;color:var(--text-muted)}
.focus-stage .run-footer>view{padding:8rpx 16rpx}
.focus-dock{flex:none;width:100%;margin-top:auto}
.focus-controls-slot{min-height:160rpx;display:flex;flex-direction:column;justify-content:flex-end;box-sizing:border-box}
.focus-controls{width:100%;box-sizing:border-box;padding:6rpx;border-radius:26rpx;background:var(--bg-control-soft);margin-bottom:14rpx}
.focus-controls .presets{padding:0;gap:8rpx}
.focus-controls .preset{display:flex;align-items:center;justify-content:center;min-height:64rpx;padding:10rpx 4rpx;border:0;border-radius:20rpx;font-size:28rpx;font-weight:500;background:var(--bg-card);color:var(--text-secondary);box-shadow:none}
.focus-controls .preset-on{background:var(--action-primary);color:var(--text-on-accent)}
.preset-pressed{opacity:.75}
.preset-edit-icon{width:23rpx;height:9rpx;border:3rpx solid currentColor;border-radius:3rpx;transform:rotate(-45deg);position:relative;box-sizing:border-box}
.preset-edit-icon::after{content:"";position:absolute;left:-7rpx;top:-3rpx;border-top:4rpx solid transparent;border-bottom:4rpx solid transparent;border-right:5rpx solid currentColor}
.focus-modes{display:flex;gap:6rpx}
.presets+.focus-modes{margin-top:6rpx}
.focus-mode{flex:1;display:flex;align-items:center;justify-content:center;min-height:64rpx;padding:10rpx 8rpx;box-sizing:border-box;border-radius:20rpx;font-size:26rpx;color:var(--text-secondary)}
.focus-mode-on{background:var(--action-primary);color:var(--text-on-accent);font-weight:600}
.focus-mode-pressed{opacity:.8}
.focus-dock .runtime-tools{margin:0 0 12rpx;gap:12rpx}
.focus-dock .runtime-tool{min-height:76rpx;border:0;border-radius:22rpx;background:var(--bg-control-soft);font-size:25rpx;font-weight:500;gap:10rpx;line-height:1.3}
.focus-dock .runtime-icon{width:28rpx;height:28rpx}
.focus-dock .runtime-icon-minimal::before{inset:2rpx}
.focus-dock .runtime-icon-minimal::after{left:9rpx;top:9rpx;width:8rpx;height:8rpx}
.focus-dock .actions{margin:0}
.focus-dock .two-col{gap:12rpx}
.focus-dock .actions .btn{min-height:84rpx;padding:14rpx 20rpx;border-radius:22rpx;font-size:27rpx;box-shadow:none}
.focus-dock .actions .btn-primary{background:var(--action-primary);border:0}
.focus-dock .actions .btn-ghost,.focus-dock .actions .btn-danger{border:0}
.focus-dock .goal-progress{margin-top:14rpx;padding:0 8rpx}
@media(max-height:740px){
  .focus-stage{padding-top:18rpx;padding-bottom:24rpx}
  .focus-stage .proj-head{margin-bottom:32rpx}
  .focus-stage .dial{width:620rpx;height:620rpx}
}
@media(max-height:650px){
  .focus-stage .dial{width:580rpx;height:580rpx}
  .focus-stage .proj-head{margin-bottom:24rpx}
  .focus-stage{padding-top:12rpx;padding-bottom:18rpx}
}
/* First-use help is an overlay, not an extra item in the carefully tuned dial layout. */
.guide-welcome-overlay{position:fixed;inset:0;z-index:950;display:flex;align-items:center;justify-content:center;padding:32rpx;box-sizing:border-box}
.guide-welcome-mask{position:absolute;inset:0;background:rgba(24,32,23,.42)}
.guide-welcome-card{position:relative;width:100%;max-width:640rpx;max-height:82vh;box-sizing:border-box;border-radius:34rpx;background:var(--bg-card);color:var(--text-primary);padding:38rpx 32rpx 28rpx;box-shadow:0 18rpx 65rpx rgba(0,0,0,.12)}
.guide-welcome-symbol{position:relative;width:66rpx;height:66rpx;border:3rpx solid var(--accent);border-radius:50%;box-sizing:border-box;margin:0 auto 22rpx;background:var(--bg-control-soft)}
.guide-welcome-clock-hand{position:absolute;left:29rpx;top:14rpx;width:3rpx;height:19rpx;background:var(--accent);border-radius:3rpx}
.guide-welcome-clock-hand::after{content:'';position:absolute;left:0;bottom:0;width:15rpx;height:3rpx;background:var(--accent);border-radius:3rpx}
.guide-welcome-title{font-size:37rpx;font-weight:600;line-height:1.4;text-align:center}
.guide-welcome-subtitle{font-size:25rpx;color:var(--text-secondary);text-align:center;margin-top:10rpx}
.guide-welcome-steps{padding:24rpx 16rpx;margin:25rpx 0;background:var(--bg-control-soft);border-radius:22rpx}
.guide-welcome-steps>view{display:flex;align-items:center;gap:18rpx;margin:0 0 23rpx}
.guide-welcome-steps>view:last-child{margin:0}
.guide-welcome-number{display:flex;align-items:center;justify-content:center;width:40rpx;height:40rpx;flex:none;background:var(--bg-card);color:var(--accent);border-radius:50%;font-size:22rpx;font-weight:600}
.guide-welcome-step-title{display:block;font-size:25rpx;font-weight:600}
.guide-welcome-step-hint{display:block;font-size:22rpx;color:var(--text-secondary);margin-top:5rpx}
.guide-welcome-actions{display:flex;gap:12rpx}
.guide-welcome-actions button{display:flex!important;align-items:center;justify-content:center;flex:1;width:auto!important;margin:0!important;min-height:82rpx;padding:18rpx 8rpx!important;box-sizing:border-box;border-radius:19rpx;line-height:1.4;font-size:26rpx;font-weight:500}
.guide-welcome-actions button::after{border:0}
.guide-welcome-skip{background:var(--bg-control-soft);color:var(--accent)}
.guide-welcome-learn{background:var(--action-primary);color:var(--text-on-accent)}
.guide-welcome-note{font-size:21rpx;color:var(--text-secondary);text-align:center;margin-top:19rpx}
.guide-welcome-pressed{opacity:.75}
