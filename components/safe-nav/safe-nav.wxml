<view style="height:{{navHeight}}px"></view><cover-view wx:if="{{!hidden}}" class="nav-cover theme-{{theme}}" style="height:{{navHeight}}px;background:{{background}}"><cover-view class="bar" style="top:{{top}}px;height:{{barHeight}}px;padding-right:{{rightInset}}px;color:{{inkColor}}"><cover-view wx:if="{{brand}}" class="brand"><cover-view class="brand-dot"></cover-view><cover-view class="bar-cover">{{title}}</cover-view></cover-view><block wx:else><cover-view wx:if="{{backText}}" id="back" class="back bar-cover" bindtap="back">{{backText}}</cover-view><cover-view class="title bar-cover">{{title}}</cover-view></block><cover-view wx:if="{{shortcut}}" id="shortcut" class="shortcut bar-cover" bindtap="shortcutTap">{{shortcut}}</cover-view><cover-view wx:if="{{refresh}}" id="refresh" class="refresh bar-cover" bindtap="refreshTap">{{refreshing?'同步中':'刷新'}}</cover-view></cover-view></cover-view>
