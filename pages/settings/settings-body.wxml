<safe-nav theme="{{themeClass}}" title="设置" back-text="‹ 返回" bindback="goBack"/>
<view class="container with-tabbar {{landscapeLayout?'landscape-shell':''}} settings-home theme-{{themeClass}}">
  <view class="landscape-only landscape-heading"><view class="landscape-title">设置</view><view class="landscape-subtitle">专注习惯、外观与账号，在这里调整。</view></view>
  <view class="settings-account-card" bindtap="openAccount" hover-class="settings-account-pressed" hover-stay-time="90">
    <view class="settings-account-avatar">
      <image wx:if="{{settingsAvatar}}" src="{{settingsAvatar}}" mode="aspectFill"/>
      <text wx:else>F</text>
    </view>
    <view class="settings-account-copy">
      <view class="settings-account-name-row">
        <text class="settings-account-name">{{settingsAccountName}}</text>
        <text wx:if="{{settingsAccountStatus}}" class="settings-account-status">{{settingsAccountStatus}}</text>
      </view>
      <text class="settings-account-hint">{{settingsAccountHint}}</text>
    </view>
    <view class="settings-account-action">{{settingsAccountAction}}<view class="settings-account-arrow"></view></view>
  </view>
  <view class="settings-intro">调整专注习惯、外观与记录管理。</view>
  <view wx:if="{{landscapeLayout}}" class="landscape-settings-columns">
    <view class="landscape-settings-column">
      <block wx:for="{{groups}}" wx:key="title"><view wx:if="{{index % 2 === 0}}" class="settings-group"><include src="settings-group.wxml"/></view></block>
    </view>
    <view class="landscape-settings-column">
      <block wx:for="{{groups}}" wx:key="title"><view wx:if="{{index % 2 === 1}}" class="settings-group"><include src="settings-group.wxml"/></view></block>
    </view>
  </view>
  <block wx:else><view wx:for="{{groups}}" wx:key="title" class="settings-group"><include src="settings-group.wxml"/></view></block>
</view>
<main-nav landscape-layout="{{landscapeLayout}}" demo-session="{{demoSession}}" selected="{{2}}" theme="{{themeClass}}"/>
