<page-meta page-style="{{themePageStyle}}"/>
<account-identity id="accountIdentity" theme="{{themeClass}}"/>
<view class="account-page theme-{{themeClass}}">
  <block wx:if="{{!toolsOnly}}">
  <view class="page-intro">管理你的 Foclo 账号与跨设备同步</view>

  <view class="account-card status-card">
    <view class="status-top">
      <view class="account-avatar {{hasAccount ? 'account-avatar-user' : 'account-avatar-guest'}}" bindtap="onEditProfile">
        <image wx:if="{{avatarUrl}}" src="{{avatarUrl}}" mode="aspectFill"/>
        <text wx:elif="{{hasAccount}}">F</text>
        <text wx:else>F</text>
      </view>
      <view class="status-copy">
        <text class="eyebrow">{{hasAccount ? 'Foclo 账号' : '当前使用方式'}}</text>
        <text class="account-name">{{accountLabel}}</text>
        <text wx:if="{{hasAccount}}" class="account-identity-hint" bindtap="copyAccountId">Foclo ID 尾号 {{accountIdText}} · 点击复制完整 ID</text>
        <text wx:else class="account-identity-hint">记录仅保存在本机</text>
      </view>
      <text class="status-pill status-{{status}}">{{statusLabel}}</text>
    </view>
    <text wx:if="{{accountPreparing}}" class="row-hint">正在读取本机账号与记录…</text>
    <text wx:if="{{statusMessage}}" class="status-message">{{statusMessage}}</text>
    <view wx:if="{{hasAccount}}" class="status-metrics">
      <text wx:if="{{pending > 0}}" class="metric-label">{{pending}} 项更改等待保存</text>
      <view class="metric metric-time">
        <text class="metric-label">{{syncedAt}}</text>
      </view>
    </view>
    <view wx:if="{{hasAccount}}" class="button-row">
      <button class="primary-button" loading="{{busy || status==='syncing'}}" disabled="{{busy || status==='syncing'}}" bindtap="onSync">刷新账号记录</button>
      <button wx:if="{{status==='auth-required'}}" class="primary-button" loading="{{busy}}" disabled="{{busy || !accountReady}}" bindtap="onLogin">重新登录</button>
      <button wx:if="{{hasAccount && status!=='auth-required' && status!=='synced' && status!=='syncing'}}" class="primary-button" loading="{{busy}}" disabled="{{busy}}" bindtap="onSync">重试保存</button>
      <button class="quiet-button" disabled="{{busy}}" bindtap="onLogout">退出登录</button>
    </view>
  </view>
  <view wx:if="{{hasAccount}}" class="profile-edit" bindtap="onEditProfile">{{avatarUrl ? '修改头像与昵称（可选）' : '设置头像与昵称（可选）'}}</view>
  <view wx:if="{{hasAccount}}" class="row-hint">已同步表示这台设备已完成最近一轮上传和下载。同账号其他设备联网后会更新；离线或正在计时的内容可能暂时不同。切换账号会使用各自独立的本机缓存。</view>

  <view wx:if="{{!hasAccount}}" class="section">
    <view class="account-card login-panel">
      <text class="login-title">登录 Foclo</text>
      <text class="login-copy">登录后，项目和专注记录会同步到 Foclo 云端，方便你更换设备后继续使用。同步服务不承诺永久保存或保证任何情况下都能恢复，重要记录请定期导出备份。</text>
      <view class="agreement-row" bindtap="toggleAgreement">
        <view class="agreement-check {{agreementAccepted ? 'checked' : ''}}"><text wx:if="{{agreementAccepted}}">✓</text></view>
        <text class="agreement-copy">我已阅读并同意</text>
        <text class="agreement-link" catchtap="openTerms">《用户服务协议》</text>
        <text class="agreement-copy">和</text>
        <text class="agreement-link" catchtap="openPrivacy">《隐私政策》</text>
      </view>
      <button class="method-login login-primary" loading="{{busy}}" disabled="{{busy || !accountReady || !agreementAccepted}}" data-method="wechat" bindtap="onLogin">微信登录并开启同步</button>
      <text class="local-use-link" bindtap="continueLocal">暂不登录，继续本地使用</text>
    </view>
  </view>

  <view wx:if="{{hasAccount && hasGuestData}}" class="section">
    <text class="section-title">登录前的记录</text>
    <view class="account-card section-card">
      <view class="section-copy">
        <text class="row-title">有登录前的记录尚未保存</text>
        <text class="row-hint">{{guestSummaryText}}</text>
      </view>
      <text class="row-hint">已保存或已删除的内容会自动跳过，不会重复统计。</text>
      <button class="secondary-button" loading="{{busy}}" disabled="{{busy}}" bindtap="onSaveGuestRecords">保存之前的记录</button>
    </view>
  </view>

  <view wx:if="{{conflicts.length}}" class="section">
    <text class="section-title">有 {{conflicts.length}} 项更改需要确认</text>
    <view wx:for="{{conflicts}}" wx:key="id" class="account-card conflict-card">
      <view class="conflict-heading">
        <text class="conflict-code">{{item.codeLabel}}</text>
        <text class="conflict-date">{{item.createdLabel}}</text>
      </view>
      <view class="diff-block">
        <text class="diff-title">账号已保存的内容</text>
        <text class="diff-json">{{item.cloudText}}</text>
      </view>
      <view class="diff-block">
        <text class="diff-title">这台设备的修改</text>
        <text class="diff-json">{{item.localText}}</text>
      </view>
      <text class="row-hint">云端内容来自同一账号之前上传的记录，可能来自这台设备，也可能来自另一台设备。本机修改是这台设备尚未同步成功的版本。请先比较，再选择如何处理。</text>
      <button class="secondary-button" data-id="{{item.id}}" disabled="{{busy}}" bindtap="onResolve">查看处理方式与影响</button>
    </view>
  </view>

  <view wx:if="{{recoveryPanel}}" class="account-card recovery-panel">
    <text class="row-title">恢复已删除内容</text>
    <text class="row-hint">选择已有项目，或另建项目保存；原冲突资料会保留。</text>
    <picker range="{{recoveryChoices}}" range-key="name" bindchange="onRecoveryPick"><view class="form-input">{{recoveryChoiceName}}</view></picker>
    <input wx:if="{{!recoveryProjectId}}" class="form-input" value="{{recoveryName}}" placeholder="新项目名称" maxlength="120" bindinput="onRecoveryNameInput"/>
    <view class="button-row">
      <button class="quiet-button" disabled="{{busy}}" bindtap="cancelRecovery">取消</button>
      <button class="primary-button" loading="{{busy}}" disabled="{{busy}}" bindtap="onRecoverDeleted">保存恢复副本</button>
    </view>
  </view>

  </block>
  <block wx:if="{{toolsOnly}}">
    <view class="page-intro">日常记录会自动保存，无需在这里操作。</view>
    <view wx:if="{{hasAccount}}" class="account-card section-card">
      <text class="row-title danger-title">删除全部记录</text>
      <text class="row-hint">删除所有项目和专注记录，账号仍可使用。其他设备也会同步删除。</text>
      <button class="danger-button" disabled="{{busy}}" bindtap="onClearAccount">删除全部记录</button>
    </view>
    <view wx:if="{{hasAccount}}" class="account-card deletion-card" bindtap="onRequestDeletion"><view class="section-copy"><text class="row-title">申请注销账号</text><text class="row-hint">申请删除账号及其数据，需审核处理</text></view><view class="chevron"></view></view>
    <view class="account-card deletion-card" bindtap="toggleAdvanced"><view class="section-copy"><text class="row-title">记录显示或保存有问题？</text><text class="row-hint">{{advancedOpen ? '收起排查选项' : '展开排查选项'}}</text></view><view class="chevron"></view></view>
    <block wx:if="{{advancedOpen}}">
      <view wx:if="{{hasAccount}}" class="account-card section-card">
        <text class="row-title">重新下载记录</text>
        <text class="row-hint">从账号重新下载，不删除记录。请先完成这台设备上的保存。</text>
        <button class="quiet-button full-button" disabled="{{busy}}" bindtap="onClearCache">重新下载</button>
      </view>
      <view class="account-card section-card">
        <text class="row-title">保存排查文件</text>
        <text class="row-hint">包含记录和保存进度，仅在排查问题时使用。</text>
        <button class="secondary-button" disabled="{{busy}}" bindtap="onExportRecovery">保存排查文件</button>
        <button class="quiet-button full-button" disabled="{{busy}}" bindtap="onExportArchived">查看以前保留的记录</button>
      </view>
    </block>
  </block>
  <view class="account-legal-links"><text bindtap="openTerms">用户服务协议</text><text bindtap="openPrivacy">隐私政策</text></view>
</view>
