@import "../../themes/palette.wxss";
:host{position:relative}

.picker-stage{width:100%;height:100vh;display:flex;align-items:center;justify-content:center;box-sizing:border-box}
.dialog{width:90%;max-width:680rpx;max-height:72vh;box-sizing:border-box;padding:24rpx;border:1rpx solid var(--border);border-radius:30rpx;background:var(--bg-card);color:var(--text-primary);box-shadow:0 24rpx 80rpx rgba(20,30,20,.16);overflow:hidden}
.head{display:flex;align-items:center;gap:16rpx;padding:2rpx 4rpx 12rpx}
.heading{flex:1;min-width:0}
.title{font-size:32rpx;line-height:1.4;font-weight:600}
.subtitle{margin-top:5rpx;font-size:21rpx;line-height:1.4;color:var(--text-muted);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.close{display:flex;align-items:center;justify-content:center;flex:none;width:68rpx;height:68rpx;border-radius:20rpx;background:var(--bg-control-soft);color:var(--text-muted)}
.close-icon{position:relative;width:22rpx;height:22rpx}
.close-icon::before,.close-icon::after{content:"";position:absolute;left:10rpx;top:0;width:2rpx;height:24rpx;border-radius:2rpx;background:currentColor;transform:rotate(45deg)}
.close-icon::after{transform:rotate(-45deg)}
.hint{padding:0 4rpx;margin:0 0 18rpx;font-size:21rpx;line-height:1.5;color:var(--text-muted)}
.options{box-sizing:border-box}
.all-option{display:flex;align-items:center;gap:14rpx;min-height:84rpx;box-sizing:border-box;margin:0 4rpx 12rpx;padding:12rpx 18rpx;border:1rpx solid var(--border);border-radius:16rpx;background:var(--bg-control-soft)}
.all-copy{display:flex;flex-direction:column;gap:3rpx;flex:1;min-width:0}
.all-title{font-size:26rpx;line-height:1.4;font-weight:600}
.all-sub{font-size:20rpx;line-height:1.4;color:var(--text-muted)}
.project-option{position:relative;display:flex;align-items:center;gap:0;min-height:96rpx;padding:0 4rpx;box-sizing:border-box;border-bottom:1rpx solid var(--border)}
.project-child{min-height:88rpx}
.project-selected{background:var(--bg-selected);border-radius:12rpx}
.project-expand{display:flex;align-items:center;justify-content:center;width:56rpx;min-height:88rpx;flex:none}
.project-child .project-expand{justify-content:flex-end;padding-right:8rpx;box-sizing:border-box}
.project-main{display:flex;align-items:center;gap:12rpx;flex:1;min-width:0;min-height:88rpx;padding:10rpx 0;box-sizing:border-box}
.tree-mark{width:14rpx;height:14rpx;border-radius:50%;flex:none}
.project-copy{display:flex;flex-direction:column;gap:3rpx;min-width:0;flex:1}
.project-label{font-size:27rpx;line-height:1.4;font-weight:600;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.project-child .project-label{font-size:26rpx;font-weight:400}
.archived{font-size:20rpx;color:var(--text-muted)}
.is-archived .project-label{color:var(--text-muted)}
.chevron{width:10rpx;height:10rpx;flex:none;border-right:2rpx solid var(--text-muted);border-bottom:2rpx solid var(--text-muted);transform:rotate(-45deg)}
.chevron.is-expanded{transform:rotate(45deg)}
.project-select{display:flex;align-items:center;justify-content:center;flex:none;min-width:80rpx;min-height:64rpx;box-sizing:border-box;margin-left:12rpx;padding:0 12rpx;border:1rpx solid var(--border);border-radius:14rpx;color:var(--accent);font-size:23rpx;font-weight:600}
.check{width:15rpx;height:9rpx;flex:none;margin-right:8rpx;border-left:3rpx solid var(--accent);border-bottom:3rpx solid var(--accent);transform:rotate(-45deg)}
.guide-rail,.guide-stem,.guide-branch{position:absolute;pointer-events:none;background:var(--border-tree);border-radius:2rpx}
.guide-rail{top:0;bottom:0;width:2rpx}
.guide-stem{top:0;width:2rpx}
.guide-full{bottom:0}
.guide-end{bottom:50%}
.guide-branch{top:50%;width:64rpx;height:2rpx}
.footer{margin-top:10rpx;padding:12rpx 4rpx 0;border-top:1rpx solid var(--border)}
.footer-close{display:flex;align-items:center;justify-content:center;min-height:72rpx;border-radius:14rpx;background:var(--bg-control-soft);color:var(--accent);font-size:24rpx;font-weight:600}
.row-pressed,.stat-pressed{background:var(--bg-control-soft)}
.pressed{opacity:.65}
.empty-hint{padding:40rpx 0;text-align:center;font-size:24rpx;color:var(--text-muted)}
