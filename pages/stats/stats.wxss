  .landscape-shell.stats-layout .summary-time-unit { font-size:13px; }
  .landscape-shell.stats-layout .summary-stripe { margin-top:12px; max-width:260px; height:5px; }
  .landscape-shell.stats-layout .summary-metrics { margin:0; flex-wrap:nowrap; align-self:center; gap:0; }
  .landscape-shell.stats-layout .summary-metric { flex:1 1 33%; min-width:0; padding:0 12px; }
  .landscape-shell.stats-layout .summary-metric-label { font-size:12px; }
  .landscape-shell.stats-layout .summary-metric-value { margin-top:10px; font-size:25px; }
  .landscape-shell.stats-layout .summary-metric-value-average { font-size:18px; }
  .landscape-shell.stats-layout .summary-metric-unit { font-size:12px; }
  .landscape-shell.stats-layout > .distribution-card { order:4; grid-column:1; }
  .landscape-shell.stats-layout > .daily-chart-card { order:4; grid-column:2; }
  .landscape-shell.stats-layout > .time-slot-card { order:5; grid-column:1 / -1; }
  .landscape-shell.stats-layout > project-list, .landscape-shell.stats-layout > .project-tree-card { order:6; grid-column:1 / -1; }
  .landscape-shell.stats-layout > .day-records, .landscape-shell.stats-layout > day-detail { order:7; grid-column:1 / -1; min-width:0; }
  .landscape-shell.stats-layout > .day-distribution, .landscape-shell.landscape-detail-today.stats-layout > .distribution-card { grid-column:1 / -1; }
  .landscape-shell stat-donut { display:block; max-width:560px; margin-left:auto; margin-right:auto; }
  .landscape-shell .distribution-header { align-items:flex-start; gap:12px; }
  .landscape-shell .distribution-hint { margin-top:5px; font-size:11px; }
  .landscape-shell .chart-tools { gap:4px; }
  .landscape-shell .chart-action { padding:0 8px; min-height:44px; font-size:12px; border-radius:10px; }
  .landscape-shell.stats-layout .title-sm { font-size:16px; font-weight:600; }
  .landscape-shell .chart-hint { margin-top:6px; font-size:11px; line-height:1.5; }
  .landscape-shell .time-slot-chart { height:126px; margin-top:16px; }
  .landscape-shell .time-slot-plot { height:100px; }
  .landscape-shell .time-slot-axis { font-size:10px; }
  .landscape-shell .slot-scale-picker { min-height:44px; display:flex; align-items:center; padding:0 9px; font-size:11px; }
  .landscape-shell .day-date-nav { gap:6px; min-height:44px; }
  .landscape-shell .day-date-arrow { width:44px; height:44px; font-size:22px; border-radius:12px; }
  .landscape-shell .day-date-picker .summary-period { display:flex; align-items:center; min-height:44px; padding:0 12px; box-sizing:border-box; font-size:13px; border-radius:12px; }
  .landscape-shell.landscape-detail .project-crumb { display:none; }
  page .container.landscape-shell.landscape-dashboard { display:flex; flex-direction:column; align-items:stretch; }
  .landscape-chart-board { display:grid; grid-template-columns:minmax(0,1fr) minmax(0,1fr); gap:16px; align-items:stretch; }
  .landscape-chart-board > .card { min-width:0; }
  .landscape-chart-board > .time-slot-card, .landscape-chart-today > .distribution-card { grid-column:1 / -1; }
}

/* Smaller tablets need full rows for readable metrics and filter labels. */
@media (min-width:680px) and (max-width:1099px) and (min-device-width:520px) and (min-device-height:520px) and (orientation:landscape) {
  .landscape-shell.stats-layout > .summary-card { grid-template-columns:minmax(0,1fr); gap:16px; }
  .landscape-shell.stats-layout .summary-well { padding:0; border-right:0; }
  .landscape-shell.stats-layout .summary-metrics { padding-top:16px; border-top:1px solid var(--divider); }
  .landscape-shell.stats-layout .summary-metric { padding:0 10px; }
  .landscape-shell.stats-layout .summary-metric-value-average { font-size:18px; }
}
@media (min-width:680px) and (max-width:759px) and (min-device-width:520px) and (min-device-height:520px) and (orientation:landscape) {
  .landscape-shell.stats-layout > .stats-sticky-controls { grid-template-columns:minmax(0,1fr); gap:8px; }
  .landscape-chart-board { grid-template-columns:minmax(0,1fr); }
}
@media (min-width:500px) and (min-device-width:520px) and (min-device-height:520px) {
  .stats-sticky-controls { position:static; margin:0 0 16px; padding:0; }
  .summary-card { padding:16px; }
  .summary-time-number { font-size:32px; }
  .summary-metric-value { font-size:22px; }
  .summary-metric-value-average { font-size:14px; white-space:nowrap; }
  .distribution-card { padding:16px; }
  .distribution-header { align-items:center; }
  .chart-action { font-size:11px; }
  .landscape-shell.stats-layout .card { padding:16px; border-radius:16px; }
  .landscape-shell.stats-layout > .summary-card { padding:16px; gap:12px; }
  .landscape-shell.stats-layout .summary-time-number { font-size:32px; }
  .landscape-shell.stats-layout .summary-metric-value { font-size:22px; margin-top:6px; }
  .landscape-shell.stats-layout .summary-metric-value-average { font-size:14px; white-space:nowrap; }
  .landscape-shell.stats-layout .summary-metric-label { font-size:11px; }
  .landscape-shell .stats-sticky-controls button.subject-entry, .landscape-shell .heat-btn { min-height:44px; height:44px; }
}
@media (min-width:760px) and (min-device-width:520px) and (min-device-height:520px) and (orientation:landscape) {
  .landscape-shell.stats-layout > .summary-card { grid-template-columns:minmax(150px,.9fr) minmax(0,1.5fr); }
  .landscape-shell.stats-layout .summary-well { border-right:1px solid var(--divider); padding-right:16px; }
  .landscape-shell.stats-layout .summary-metrics { border-top:0; padding-top:0; }
  .landscape-chart-today > .distribution-card { display:grid; grid-template-columns:minmax(150px,1fr) minmax(220px,320px); gap:16px; align-items:center; }
  .landscape-chart-today .distribution-header { flex-direction:column; align-items:flex-start; justify-content:center; gap:16px; }
}
@media (min-width:500px) and (min-device-width:520px) and (min-device-height:520px) {
  .stats-layout stat-donut, .landscape-shell stat-donut { display:block; width:100%; min-width:0; }
}
@media (min-width:760px) and (min-device-width:520px) and (min-device-height:520px) and (orientation:landscape) {
  .landscape-chart-today { grid-template-columns:minmax(0,.9fr) minmax(0,1.1fr); align-items:start; }
  .landscape-chart-today > .distribution-card { display:block; grid-column:1; }
  .landscape-chart-today .distribution-header { flex-direction:row; justify-content:space-between; align-items:center; gap:12px; }
  .landscape-chart-today > .day-records { min-width:0; grid-column:2; margin:0; }
}
