<account-entry id="accountEntry" theme="{{themeClass}}" bindvisibilitychange="onIdentityVisibility"/>
<safe-nav id="safeNav" theme="{{themeClass}}" brand="{{true}}" title="Foclo" bindheightchange="onFocusNavHeight" hidden="{{activeTab!==0||customOpen||todayOpen||immersive||screenLocked}}"/>
<!-- 主视图 -->
<view hidden="{{identityOpen}}" class="container with-tabbar {{tabletLayout?'tablet-focus':''}} {{landscapeLayout?'landscape-shell':''}} focus-layout {{cur && cur.state==='IDLE'?'focus-layout-idle':'focus-layout-running'}} {{activeTab!==0?'focus-layout-hidden':''}} theme-{{themeClass}}" style="min-height:calc(100vh - {{focusNavHeight}}px);--focus-nav-height:{{focusNavHeight}}px;{{focusLayoutStyle}}">
  <view class="landscape-only landscape-heading"><view class="landscape-title">专注空间</view><view class="landscape-subtitle">{{cur.state==='IDLE' ? '选好内容，开始这一段专注。' : '按自己的节奏，完成这一段专注。'}}</view></view>
  <view wx:if="{{blocked}}" class="card">
    <view class="title">数据需要处理</view>
    <view class="muted">{{blocked.message}}</view>
  </view>

  <block wx:if="{{cur}}">
    <view wx:if="{{otherDeviceFocus}}" class="card"><view class="title">另一设备近期上报了未结束的计时</view><view class="muted">它此刻可能已离线。请在原设备确认是否还需计时；这里不会替你停止或删除它的记录。</view></view>
    <view wx:if="{{tabletLayout}}" class="tablet-focus-workspace {{focusWideLayout?'focus-workspace-wide':'focus-workspace-tall'}}"><include src="focus-workspace.wxml"/></view>
    <block wx:else><include src="focus-workspace.wxml"/></block>
  </block>
</view>
<page-container show="{{focusHistoryEnabled && (pickerOpen || customOpen || todayOpen || immersive)}}" overlay="{{false}}" position="center" duration="0" custom-style="width:1px;height:1px;opacity:0;background:transparent;" bindafterenter="onFocusHistoryEnter" bindafterleave="onPickerAfterLeave"><view style="width:1px;height:1px;"/></page-container>
<project-sheet demo-session="{{demoSession}}" top-inset="{{focusNavHeight}}" bottom-nav="{{true}}" theme="{{themeClass}}" id="projectSheet" opened="{{pickerOpen}}" selected="{{cur && cur.projectId || ''}}" bindclose="closePicker" bindselected="projectSelected" bindchanged="refresh" bindopenappearance="openPickerAppearance" bindopenmanage="openPickerManage"/>
<main-nav id="mainNav" landscape-layout="{{landscapeLayout}}" demo-session="{{demoSession}}" selected="{{0}}" theme="{{themeClass}}" hidden="{{immersive||screenLocked||identityOpen}}"/>
<view wx:if="{{restPrompt}}" class="focus-overlay rest-overlay theme-{{themeClass}}"><view class="focus-mask"></view><view class="focus-sheet rest-sheet"><view class="rest-icon">☕</view><view class="title-sm">这一轮完成了</view><view class="rest-description">已保存专注记录 · 第 {{restRound}} 轮</view><view class="rest-duration">{{restLong ? '长休息' : '短休息'}} · {{restDuration / 60}} 分钟</view><view class="two-col rest-actions"><button class="btn btn-ghost" bindtap="skipRest">跳过</button><button class="btn btn-primary" bindtap="startRest">开始休息</button></view></view></view>
<view wx:if="{{restState}}" class="focus-overlay rest-overlay theme-{{themeClass}}"><view class="focus-mask"></view><view class="focus-sheet rest-sheet"><view class="rest-icon">☕</view><view class="title-sm">{{restState === 'PAUSED' ? '休息已暂停' : '休息中'}}</view><view class="rest-clock num">{{restClock}}</view><view class="rest-description">休息单独计时，不计入专注统计</view><view class="two-col rest-actions"><button wx:if="{{restState === 'RUNNING'}}" class="btn btn-ghost" bindtap="pauseRest">暂停</button><button wx:else class="btn btn-ghost" bindtap="resumeRest">继续</button><button class="btn btn-danger" bindtap="skipRest">跳过休息</button></view></view></view>
<view wx:if="{{customOpen}}" class="focus-overlay theme-{{themeClass}}" catchtouchmove="noop"><view class="focus-mask" bindtap="closeCustom"></view><view class="focus-sheet"><view class="title-sm">自定义专注时长</view><picker-view class="minute-wheel" immediate-change="{{true}}" indicator-style="{{minuteIndicatorStyle}}" value="{{minuteWheelValue}}" bindchange="minutePick"><picker-view-column><view wx:for="{{minuteOptions}}" wx:key="*this" class="minute-option">{{item}}</view></picker-view-column></picker-view><view class="minute-entry"><input class="minute-entry-input" type="number" value="{{customMinutes}}" bindinput="minuteInput" maxlength="4"/><text>分钟（1–1440）</text></view><view class="two-col"><button class="btn btn-ghost" bindtap="closeCustom">取消</button><button class="btn btn-primary" bindtap="confirmCustom">确定</button></view></view></view>
<view wx:if="{{todayOpen}}" class="focus-overlay theme-{{themeClass}}"><view class="focus-mask" bindtap="closeToday"></view><scroll-view scroll-y class="focus-sheet today-sheet"><view class="row-between"><view class="title-sm">今日专注明细</view><view bindtap="closeToday">✕</view></view><day-detail id="todayDetail" theme="{{themeClass}}" demo-session="{{demoSession}}" date="{{todayDate}}" controls="{{false}}" bindrecorddeleted="onRecordDeleted" bindrecordchanged="onRecordDeleted"/></scroll-view></view>
<view wx:if="{{immersive}}" class="zen theme-{{themeClass}}"><view class="zen-path">{{projectPath||cur.projectName}}</view><view class="flip-clock"><view wx:for="{{clockParts}}" wx:key="key" class="flip-group"><view class="flip-face flip-turn-{{item.turn}} num">{{item.value}}</view><view class="flip-unit">{{item.unit}}</view></view></view><view>{{pillText}} · {{captionText}}</view><view class="zen-controls"><button class="btn btn-ghost" bindtap="closeImmersive">退出极简</button><button wx:if="{{cur.state==='STUDYING'}}" class="btn btn-primary" bindtap="onPause">暂停</button><button wx:else class="btn btn-primary" bindtap="onResume">继续</button></view></view>
<view wx:if="{{screenLocked}}" class="screen-lock theme-{{themeClass}}" catchtap="noop" catchtouchmove="noop" bindlongpress="unlockScreen"><view class="lock-indicator"><view class="runtime-icon runtime-icon-lock"></view><text>已开启防误触</text></view><view class="locked-clock num">{{bigText}}</view><view>长按屏幕解除</view></view>
<view wx:if="{{welcomeOpen}}" class="guide-welcome-overlay theme-{{themeClass}}" catchtouchmove="noop">
  <view class="guide-welcome-mask"></view>
  <scroll-view scroll-y class="guide-welcome-card">
    <view class="guide-welcome-symbol"><view class="guide-welcome-clock-hand"></view></view>
    <view class="guide-welcome-title">欢迎使用 Foclo</view>
    <view class="guide-welcome-subtitle">选择项目 → 开始专注 → 到统计复盘</view>
    <view class="guide-welcome-steps">
      <view wx:for="{{welcomeFeatures}}" wx:key="label" class="guide-welcome-step"><view class="guide-welcome-feature-label">{{item.label}}</view><view class="guide-welcome-step-copy"><text class="guide-welcome-step-title">{{item.title}}</text><text class="guide-welcome-step-hint">{{item.hint}}</text></view></view>
    </view>
    <view class="guide-welcome-actions"><button class="guide-welcome-button guide-welcome-skip" bindtap="openWelcomeGuide" hover-class="guide-welcome-pressed">看看特色功能</button><button class="guide-welcome-button guide-welcome-learn" bindtap="dismissWelcome" hover-class="guide-welcome-pressed">开始使用</button></view>
    <view class="guide-welcome-note">更多用法在 设置 → 使用指南</view>
  </scroll-view>
</view>
