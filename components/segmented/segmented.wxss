.seg {
  display: flex;
  background: var(--bg-control);
  border-radius: 24rpx;
  padding: 6rpx;
  box-sizing: border-box;
}

.seg-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 68rpx;
  padding: 10rpx 12rpx;
  border-radius: 20rpx;
  font-size: 26rpx;
  font-weight: 500;
  color: var(--text-secondary);
  text-align: center;
  box-sizing: border-box;
}

.seg-on-green {
  background: var(--accent);
  color:var(--text-on-accent);
  font-weight: 600;
  box-shadow: 0 4rpx 12rpx rgba(61, 90, 64, 0.16);
}

.seg-on-light {
  background:var(--bg-card);
  color: var(--accent);
  font-weight: 600;
  box-shadow: 0 2rpx 8rpx rgba(30, 34, 30, 0.08);
}
