.account-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 24rpx 30rpx calc(40rpx + env(safe-area-inset-bottom));
}
.advanced-toggle { padding: 30rpx 8rpx; color: var(--text-secondary); font-size: 25rpx; }
.account-avatar { flex:none; width:88rpx; height:88rpx; border-radius:50%; overflow:hidden; display:flex; align-items:center; justify-content:center; background:var(--bg-control-soft); color:var(--accent); }
.account-avatar image { width:100%; height:100%; }
.account-avatar text { font-size:38rpx; font-weight:700; }
.account-avatar-user { width:104rpx; height:104rpx; background:var(--accent-soft); }
.account-avatar-guest { background:var(--bg-control-soft); }
.account-identity-hint { font-size:20rpx; color:var(--text-secondary); overflow-wrap:anywhere; }
.profile-edit { text-align:right; padding:16rpx 8rpx 0; font-size:23rpx; color:var(--accent); }
.login-panel { padding:30rpx; }
.login-title { display:block; color:var(--text-primary); font-size:31rpx; font-weight:700; }
.login-copy { display:block; margin-top:14rpx; color:var(--text-secondary); font-size:24rpx; line-height:1.7; }
.agreement-row { display:flex; flex-wrap:wrap; align-items:center; gap:7rpx; margin-top:24rpx; min-height:52rpx; color:var(--text-secondary); font-size:22rpx; line-height:1.6; }
.agreement-check { width:30rpx; height:30rpx; margin-right:5rpx; border:2rpx solid var(--text-muted); border-radius:8rpx; box-sizing:border-box; display:flex; align-items:center; justify-content:center; color:var(--text-on-accent); font-size:21rpx; }
.agreement-check.checked { border-color:var(--accent); background:var(--accent); }
.agreement-link { color:var(--accent); }
.login-primary { display:block; width:100%!important; min-height:84rpx; margin-top:22rpx!important; padding:22rpx 24rpx!important; font-size:27rpx!important; }
.local-use-link { display:block; margin-top:22rpx; padding:8rpx; text-align:center; color:var(--text-secondary); font-size:23rpx; }
.login-method-row { display:flex; align-items:center; justify-content:space-between; gap:20rpx; padding:26rpx 30rpx; }
.login-method-row + .login-method-row { border-top:1rpx solid var(--divider); }
.method-current { flex:none; color:var(--accent); font-size:23rpx; }
.method-login { flex:none; width:auto!important; margin:0!important; padding:12rpx 26rpx; font-size:25rpx; line-height:1.5; border-radius:14rpx; color:var(--text-on-accent); background:var(--action-primary); }
.method-login::after { border:0; }
.page-intro {
  color: var(--text-secondary);
  font-size: 25rpx;
  margin: 18rpx 4rpx 30rpx;
}
.account-card {
  background: var(--bg-card);
  border: 1rpx solid var(--border);
  border-radius: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(61, 90, 64, 0.035);
}
.status-card {
  padding: 32rpx 28rpx;
}
.status-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}
.status-copy {
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}
.eyebrow {
  color: var(--text-muted);
  font-size: 22rpx;
}
.account-name {
  color: var(--text-primary);
  font-size: 34rpx;
  font-weight: 700;
  overflow-wrap: anywhere;
}
.status-pill {
  flex: none;
  max-width: 40%;
  padding: 10rpx 17rpx;
  border-radius: 999rpx;
  background: var(--bg-tag);
  color: var(--text-tag);
  font-size: 22rpx;
}
.status-syncing {
  background: var(--warning-bg);
  color: var(--status-paused);
}
.status-failed,
.status-conflict,
.status-quarantined {
  background: var(--danger-bg);
  color: var(--danger-text);
}
.status-message {
  display: block;
  margin-top: 16rpx;
  color: var(--danger-text);
  font-size: 23rpx;
  line-height: 1.55;
}
.status-metrics {
  display: flex;
  align-items: center;
  min-height: 90rpx;
  margin-top: 20rpx;
  padding: 12rpx 0;
  border-top: 1rpx solid var(--divider);
  border-bottom: 1rpx solid var(--divider);
}
.metric {
  display: flex;
  flex-direction: column;
  gap: 3rpx;
}
.metric-value {
  color: var(--text-primary);
  font-size: 32rpx;
  font-weight: 700;
}
.metric-label {
  color: var(--text-muted);
  font-size: 22rpx;
}
.metric-divider {
  height: 44rpx;
  width: 1rpx;
  margin: 0 26rpx;
  background: var(--divider);
}
.metric-time {
  flex: 1;
}
.button-row {
  display: flex;
  gap: 14rpx;
  margin-top: 22rpx;
}
button {
  margin: 0;
  line-height: 1.4;
  font-size: 25rpx;
  font-weight: 600;
}
button::after {
  border: 0;
}
.primary-button,
.secondary-button,
.quiet-button,
.danger-button {
  min-height: 82rpx;
  padding: 20rpx 24rpx;
  border-radius: 17rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}
.primary-button {
  flex: 1;
  color: var(--text-on-accent);
  background: var(--action-primary);
}
.primary-button:active {
  background: var(--action-primary-pressed);
}
.secondary-button {
  width: 100%;
  margin-top: 18rpx;
  color: var(--accent);
  background: var(--accent-soft);
}
.quiet-button {
  flex: 1;
  color: var(--text-secondary);
  background: var(--action-secondary);
}
.danger-button {
  width: 100%;
  margin-top: 17rpx;
  color: var(--danger-text-strong);
  background: var(--danger-bg);
}
button[disabled] {
  opacity: 0.48;
}
.section {
  margin-top: 34rpx;
}
.section-title {
  display: block;
  color: var(--text-muted);
  font-size: 23rpx;
  font-weight: 700;
  margin: 0 8rpx 12rpx;
}
.section-card {
  padding: 25rpx 27rpx;
}
.section-copy {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}
.row-title {
  color: var(--text-primary);
  font-size: 27rpx;
  font-weight: 650;
}
.row-hint {
  color: var(--text-muted);
  font-size: 22rpx;
  line-height: 1.6;
}
.form-input {
  box-sizing: border-box;
  min-width: 0;
  border: 1rpx solid var(--border);
  border-radius: 14rpx;
  background: var(--bg-input);
  color: var(--text-primary);
  font-size: 23rpx;
  padding: 16rpx 18rpx;
}
.conflict-card {
  margin-bottom: 18rpx;
  padding: 25rpx;
}
.conflict-heading {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16rpx;
}
.conflict-code {
  color: var(--danger-text-strong);
  font-size: 24rpx;
  font-weight: 700;
}
.conflict-date {
  color: var(--text-muted);
  font-size: 19rpx;
}
.diff-block {
  margin-top: 20rpx;
}
.diff-title {
  display: block;
  color: var(--text-secondary);
  font-size: 21rpx;
  font-weight: 700;
  margin-bottom: 8rpx;
}
.diff-json {
  display: block;
  box-sizing: border-box;
  max-height: 260rpx;
  overflow: auto;
  padding: 15rpx;
  border-radius: 12rpx;
  background: var(--bg-surface-soft);
  color: var(--text-primary);
  font-family: monospace;
  font-size: 19rpx;
  line-height: 1.5;
  white-space: pre-wrap;
  word-break: break-all;
}
.recovery-panel {
  margin-top: 24rpx;
  padding: 26rpx;
}
.recovery-panel .row-hint {
  margin: 8rpx 0 18rpx;
}
.form-input {
  width: 100%;
  height: 78rpx;
  margin-top: 14rpx;
}
.divider {
  height: 1rpx;
  margin: 23rpx 0;
  background: var(--divider);
}
.account-export-copy {
  margin-top: 0;
}
.danger-title {
  color: var(--danger-text-strong);
}
.full-button {
  width: 100%;
  margin-top: 16rpx;
}
.deletion-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  margin-top: 14rpx;
  padding: 24rpx 27rpx;
}
.chevron {
  width: 14rpx;
  height: 14rpx;
  flex: none;
  border-top: 3rpx solid var(--text-muted);
  border-right: 3rpx solid var(--text-muted);
  transform: rotate(45deg);
  margin-right: 5rpx;
}
.bottom-note {
  margin: 25rpx 8rpx 0;
  color: var(--text-muted);
  font-size: 21rpx;
  line-height: 1.6;
  text-align: center;
}
.account-legal-links { display: flex; justify-content: center; gap: 32rpx; padding: 28rpx 8rpx; color: var(--text-secondary); font-size: 24rpx; }
.account-legal-links text { padding: 12rpx 0; }
