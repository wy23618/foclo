.mg-main{transition:transform 100ms ease,opacity 100ms ease}
.mg-row-pressed{transform:scale(.987);opacity:.78}
.mg-new,.mg-tool,.mg-sort,.mg-tree-toggle,.mg-edit-entry,.mg-editor-close,.mg-editor-link,.mg-editor-cancel,.mg-editor-save,.mg-editor-secondary button,.mg-more-colors,.mg-default-color,.mg-swatch-target,.mg-parent-input,.mg-search-clear{transition:transform 100ms ease,opacity 100ms ease}
