.settings-page { min-height: 100vh; }
.setting-card { background: var(--bg-card); border: 1rpx solid var(--border); border-radius: 28rpx; padding: 0 26rpx; box-shadow: 0 4rpx 16rpx rgba(61,90,64,.035); margin-bottom: 22rpx; }
.setting-row { display: flex; align-items: center; min-height: 104rpx; padding: 18rpx 0; box-sizing: border-box; border-bottom: 1rpx solid var(--divider); gap: 12rpx; }
.setting-row:last-child { border-bottom: 0; }
.row-copy { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 3rpx; }
.row-title { font-size: 28rpx; color: var(--text-primary); font-weight: 600; }
.row-summary { font-size: 22rpx; color: var(--text-muted); }
.row-value { font-size: 23rpx; color: var(--accent); white-space: nowrap; }
.toggle { width: 74rpx; height: 42rpx; padding: 4rpx; border-radius: 999rpx; background: var(--control-off); box-sizing: border-box; display: flex; align-items: center; transition: background .18s ease; }
.toggle-on { background: var(--accent); justify-content: flex-end; }
.toggle-dot { width: 34rpx; height: 34rpx; border-radius: 50%; background: var(--control-thumb); box-shadow: 0 2rpx 6rpx rgba(0,0,0,.12); }
.chevron { width: 14rpx; height: 14rpx; flex: none; border-top: 3rpx solid var(--text-muted); border-right: 3rpx solid var(--text-muted); transform: rotate(45deg); margin: 0 8rpx; opacity: .65; }
.chevron-down { transform: rotate(135deg); margin-bottom: 8rpx; }
.detail-note { font-size: 23rpx; color: var(--text-secondary); margin: 2rpx 6rpx 20rpx; }
.detail-group-title { color: var(--text-muted); font-size: 23rpx; font-weight: 600; margin: 16rpx 8rpx 12rpx; }
.detail-card { padding: 0 28rpx; }
.detail-card .setting-row { min-height: 116rpx; }
.preset-editor { padding: 24rpx 0 28rpx; border-bottom: 1rpx solid var(--divider); }
.break-options { padding: 8rpx 0 24rpx; border-bottom: 1rpx solid var(--divider); }
.break-option { display: flex; align-items: center; justify-content: space-between; min-height: 76rpx; color: var(--text-secondary); font-size: 24rpx; }
.option-select { min-width: 150rpx; padding: 10rpx 16rpx; border-radius: 16rpx; background: var(--bg-control-soft); color: var(--accent); display: flex; align-items: center; justify-content: center; gap: 12rpx; }
.select-down { width: 11rpx; height: 11rpx; border-right: 2rpx solid currentColor; border-bottom: 2rpx solid currentColor; transform: rotate(45deg); margin-top: -5rpx; }
.preset-pickers { display: flex; gap: 12rpx; margin-top: 18rpx; }
.preset-choice { min-width: 108rpx; padding: 14rpx 18rpx; text-align: center; color: var(--accent); font-size: 26rpx; font-weight: 600; background: var(--bg-control-soft); border-radius: 18rpx; }
.preset-choice text { font-size: 20rpx; font-weight: 400; }
.data-note { background: var(--bg-note); color: var(--text-secondary); font-size: 23rpx; line-height: 1.7; padding: 24rpx 26rpx; border-radius: 22rpx; margin: 4rpx 0 18rpx; }
.display-tip { color: var(--text-secondary); font-size: 24rpx; line-height: 1.8; background: var(--bg-control-soft); border-radius: 20rpx; padding: 22rpx 26rpx; }
.display-tip-title { color: var(--text-primary); font-weight: 600; margin-bottom: 6rpx; }
.loading { padding: 120rpx 0; text-align: center; color: var(--text-muted); }
.danger-row .row-title { color: var(--danger-text-strong); }
.theme-dark .danger-row .row-title { color: var(--danger-text-strong); }
.theme-options { display: flex; gap: 14rpx; padding: 24rpx 0; border-bottom: 1rpx solid var(--divider); }
.theme-choice { flex: 1; min-width: 0; padding: 10rpx; border: 2rpx solid var(--border); border-radius: 18rpx; box-sizing: border-box; background: var(--bg-card); }
.theme-choice-on { border-color: var(--accent); box-shadow: 0 0 0 2rpx var(--accent-soft); }
.theme-preview { height: 96rpx; position: relative; overflow: hidden; border-radius: 12rpx; margin-bottom: 12rpx; }
.theme-preview { background: var(--bg-page); }
.theme-preview-cherry-pink { background: var(--bg-page); }
.theme-preview-dark { background: var(--bg-page); }
.theme-preview-system { display: flex; background: var(--bg-page); }
.preview-half { width: 50%; height: 100%; }
.preview-half { background: var(--bg-page); }
.preview-cherry-pink { background: var(--bg-page); }
.preview-dark { background: var(--bg-page); }
.preview-card { position: absolute; left: 14rpx; top: 17rpx; width: 64%; height: 48rpx; border-radius: 8rpx; background: var(--bg-card); box-shadow: 0 2rpx 8rpx rgba(0,0,0,.12); }
.theme-preview-dark .preview-card,.theme-preview-system .preview-card { left: 42%; width: 48%; background: var(--bg-card); }
.preview-line { position: absolute; left: 16rpx; right: 16rpx; bottom: 15rpx; height: 5rpx; border-radius: 5rpx; background: var(--accent); }
.theme-preview-dark .preview-line,.theme-preview-system .preview-line { background: var(--accent); }
.theme-choice-copy { display: flex; align-items: center; justify-content: space-between; gap: 4rpx; min-height: 34rpx; }
.theme-choice-name { color: var(--text-primary); font-size: 22rpx; white-space: nowrap; }
.theme-check { color: var(--accent); font-size: 23rpx; font-weight: 700; }
.theme-dark .theme-choice { background: var(--bg-card); }
.theme-dark .theme-choice-name { color: var(--text-primary); }
.light-palette-row { padding: 18rpx 0 22rpx; border-bottom: 1rpx solid var(--divider); }
.light-palette-title { display: block; margin-bottom: 12rpx; color: var(--text-secondary); font-size: 22rpx; }
.light-palette-options { display: flex; flex-wrap: wrap; gap: 14rpx; }
.light-palette-choice { flex: 0 0 calc((100% - 28rpx) / 3); min-width: 0; box-sizing: border-box; display: flex; align-items: center; gap: 12rpx; padding: 10rpx 12rpx; border: 2rpx solid var(--border); border-radius: 14rpx; color: var(--text-primary); font-size: 22rpx; }
.light-palette-choice text { flex: 1; min-width: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.light-palette-choice-on { border-color: var(--accent); }
.palette-preview { display: flex; flex: none; gap: 3rpx; padding: 3rpx; border-radius: 999rpx; background: var(--bg-surface-soft); }
.palette-swatch { width: 20rpx; height: 20rpx; border-radius: 50%; border: 1rpx solid var(--border); box-sizing: border-box; }
.palette-swatch.palette-page { background: var(--bg-page); }
.palette-swatch.palette-card { background: var(--bg-card); }
.palette-swatch.palette-soft { background: var(--accent-soft); }
.palette-swatch.palette-accent { background: var(--accent); }
