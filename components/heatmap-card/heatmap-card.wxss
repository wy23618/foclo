@import "../../themes/palette.wxss";
:host{display:block}.overlay{position:fixed;inset:0 0 calc(92rpx + env(safe-area-inset-bottom));z-index:600;display:flex;align-items:center;justify-content:center;color:var(--text-primary)}
.mask{position:absolute;inset:0;background:rgba(25,35,27,.35)}
.panel{position:relative;width:calc(100% - 48rpx);max-width:700rpx;background:var(--bg-card);border:1rpx solid var(--border);border-radius:32rpx;box-shadow:0 24rpx 80rpx rgba(0,0,0,.14);overflow:hidden}
.head{display:flex;align-items:center;justify-content:space-between;padding:22rpx 26rpx 10rpx}.title{font-size:29rpx;font-weight:700}.close{padding:14rpx 10rpx;font-size:24rpx;color:var(--text-secondary)}.pressed{opacity:.6}
.body{box-sizing:border-box;padding-bottom:8rpx}.scope,.month-nav,.calendar,.summary,.legend,.hint{margin-left:22rpx;margin-right:22rpx}
.scope{display:flex;align-items:center;justify-content:space-between;gap:12rpx;padding:16rpx 14rpx;border-radius:18rpx;background:var(--bg-control-soft);font-size:24rpx;overflow-wrap:anywhere}.scope text{flex:none;font-size:21rpx;color:var(--text-secondary)}
.month-nav{display:flex;align-items:center;gap:10rpx;padding:18rpx 0}.arrow{width:64rpx;height:64rpx;display:flex;align-items:center;justify-content:center;font-size:38rpx;border-radius:18rpx;background:var(--bg-control-soft);color:var(--accent)}.off{color:var(--text-muted);background:transparent}.month-picker{flex:1;text-align:center;font-size:29rpx;font-weight:600}
.week,.cal-row{display:flex}.week{margin-bottom:8rpx}.week text{flex:1;text-align:center;font-size:21rpx;color:var(--text-secondary)}.cal-slot{flex:1;min-width:0}.cell{aspect-ratio:1 / 1;min-height:0;margin:4rpx;border-radius:12rpx;display:flex;flex-direction:column;align-items:center;justify-content:center;box-sizing:border-box}.day{font-size:22rpx;line-height:1.3}.duration{font-size:17rpx;line-height:1.4;margin-top:4rpx;white-space:nowrap;font-variant-numeric:tabular-nums}
.month-stage{position:relative;overflow:hidden}.month-page{position:relative}.month-page-outgoing{position:absolute;inset:0;z-index:2;pointer-events:none}.month-page-current{z-index:3}.month-page-preview{position:absolute;top:0;left:0;width:100%;z-index:4;pointer-events:none}.drag-animating{transition:transform 300ms cubic-bezier(.22,.7,.25,1)}.preview-loading{position:absolute;top:50%;left:50%;padding:6rpx 12rpx;border-radius:999rpx;transform:translate(-50%,-50%);background:rgba(35,49,39,.7);color:var(--text-on-accent);font-size:20rpx}.month-label{flex:1;text-align:center;font-size:29rpx;font-weight:600}.enter-from-right{animation:heatmap-enter-right 300ms cubic-bezier(.22,.7,.25,1) both}.enter-from-left{animation:heatmap-enter-left 300ms cubic-bezier(.22,.7,.25,1) both}.exit-to-left{animation:heatmap-exit-left 300ms cubic-bezier(.22,.7,.25,1) both}.exit-to-right{animation:heatmap-exit-right 300ms cubic-bezier(.22,.7,.25,1) both}
@keyframes heatmap-enter-right{from{opacity:.15;transform:translateX(24rpx)}to{opacity:1;transform:translateX(0)}}@keyframes heatmap-enter-left{from{opacity:.15;transform:translateX(-24rpx)}to{opacity:1;transform:translateX(0)}}@keyframes heatmap-exit-left{from{opacity:1;transform:translateX(0)}to{opacity:.15;transform:translateX(-24rpx)}}@keyframes heatmap-exit-right{from{opacity:1;transform:translateX(0)}to{opacity:.15;transform:translateX(24rpx)}}
.today{border:2rpx solid var(--accent)}.future{border:1rpx dashed var(--border);background:transparent;color:var(--text-muted)}.outside{background:transparent;color:var(--text-muted);opacity:.35}
.summary{display:flex;gap:18rpx;margin-top:22rpx;padding-top:18rpx;border-top:1rpx solid var(--border)}.summary>view{flex:1;display:flex;flex-direction:column;gap:7rpx}.label{font-size:21rpx;color:var(--text-secondary)}.value{font-size:26rpx;font-weight:600}
.legend{display:flex;align-items:center;justify-content:center;gap:10rpx;margin-top:20rpx;color:var(--text-secondary);font-size:20rpx}.heat-gradient{width:190rpx;height:18rpx;border-radius:999rpx;background:linear-gradient(to right,var(--heat-0),var(--heat-1),var(--heat-2),var(--heat-3),var(--heat-4))}.hint{text-align:center;font-size:20rpx;line-height:1.5;color:var(--text-secondary);padding:14rpx 0 24rpx}.message{padding:24rpx;text-align:center;font-size:24rpx;color:var(--text-secondary)}
.scope-name{flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.scope-picker-overlay{position:absolute;inset:0;z-index:3;display:flex;align-items:center;justify-content:center}.scope-picker-mask{position:absolute;inset:0;background:rgba(20,28,22,.35)}.scope-dialog{position:relative;width:calc(100% - 56rpx);max-width:660rpx;max-height:78vh;box-sizing:border-box;padding:22rpx;background:var(--bg-card);border:1rpx solid var(--border);border-radius:28rpx;box-shadow:0 20rpx 64rpx rgba(0,0,0,.18);display:flex;flex-direction:column;color:var(--text-primary)}.scope-head{display:flex;align-items:center;justify-content:space-between;font-size:28rpx;font-weight:650}.scope-close{width:54rpx;height:54rpx;display:flex;align-items:center;justify-content:center;border-radius:50%;background:var(--bg-control-soft);font-size:34rpx;color:var(--text-secondary)}.scope-search{height:76rpx;box-sizing:border-box;margin:14rpx 0 12rpx;padding:0 18rpx;border-radius:16rpx;background:var(--bg-control-soft);font-size:24rpx;color:var(--text-primary)}.scope-section-label{display:block;margin:10rpx 2rpx;font-size:20rpx;color:var(--text-secondary)}.recent-list{display:flex;flex-wrap:wrap;gap:8rpx}.recent-item{max-width:100%;padding:9rpx 14rpx;border-radius:20rpx;background:var(--bg-control-soft);font-size:21rpx;color:var(--text-secondary);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.recent-selected{color:var(--accent);background:var(--heat-1)}.scope-options{flex:1;min-height:140rpx;max-height:48vh}.scope-row{display:flex;align-items:center;min-height:68rpx;margin-top:5rpx;border-bottom:1rpx solid var(--border)}.scope-row-main{display:flex;align-items:center;gap:12rpx;min-width:0;flex:1;min-height:66rpx}.scope-project-dot{width:11rpx;height:11rpx;flex:none;border-radius:50%;background:var(--accent)}.scope-row-copy{display:flex;flex-direction:column;min-width:0;flex:1}.scope-option-name{font-size:23rpx;line-height:1.4;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.scope-path{font-size:18rpx;line-height:1.4;color:var(--text-secondary);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.scope-check{padding:0 14rpx;color:var(--accent);font-weight:700}.scope-expand{width:58rpx;height:58rpx;flex:none;display:flex;align-items:center;justify-content:center;border-radius:14rpx;background:var(--bg-control-soft)}.scope-chevron{width:11rpx;height:11rpx;border-right:2rpx solid var(--text-secondary);border-bottom:2rpx solid var(--text-secondary);transform:rotate(-45deg)}.scope-expanded .scope-chevron{transform:rotate(45deg)}.scope-archived .scope-option-name{color:var(--text-secondary)}.all-scope-row{padding-left:0!important}.scope-empty{padding:36rpx 10rpx;text-align:center;font-size:22rpx;color:var(--text-secondary)}.scope-picker-footer{flex:none;margin-top:14rpx;padding:15rpx;text-align:center;border-radius:16rpx;background:var(--bg-control-soft);color:var(--accent);font-size:24rpx;font-weight:600}
