<view class="tree">
  <view wx:for="{{visibleGroups}}" wx:key="projectId" wx:for-item="group" class="tree-group">
    <view wx:for="{{group.rows}}" wx:key="projectId" class="tablet-inline tree-row {{item.depth?'tree-child':'tree-parent'}} {{item.selected?'tree-row-selected':''}}" style="--tablet-value-margin-left:calc({{item.depth?item.indent:0}} * .6px);margin-left:var(--tablet-length-margin-left, {{item.depth?item.indent:0}}rpx)" data-id="{{item.projectId}}" bindtap="toggle">
      <view class="tree-main"><view class="dot" style="background:{{item.color}}"></view><view class="tree-copy"><text class="name">{{item.name}}<text wx:if="{{item.archived}}" class="archived"> · 已归档</text></text><text wx:if="{{item.seconds > 0}}" class="tree-meta">{{item.secondsText}} · 占{{item.parentName}} {{item.parentPct}}</text><text wx:else class="tree-meta">还没有专注记录</text><view class="tree-track"><view class="tree-fill" style="width:{{item.parentWidth}}%;background:{{item.color}}"></view></view></view></view>
      <view wx:if="{{item.includesChildren}}" class="toggle" data-id="{{item.projectId}}" catchtap="toggle"><view class="chevron {{item.expanded?'chevron-open':''}}"></view></view>
      <view wx:else class="go" data-id="{{item.projectId}}" catchtap="select" hover-class="row-pressed"><text>统计</text><view class="go-chevron"></view></view>
    </view>
  </view>
</view>
