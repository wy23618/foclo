@import "../../themes/palette.wxss";
:host{display:block}.nav-cover{position:fixed;top:0;left:0;right:0;z-index:50;background:var(--bg-page)}.bar{position:absolute;left:0;right:0;box-sizing:border-box;padding-left:16px;display:flex;align-items:center;justify-content:flex-end;color:var(--text-control);font-size:13.5px;line-height:32px}.brand{display:flex;align-items:center;flex:1;font-weight:600;font-size:14px}.brand-dot{width:5px;height:5px;border-radius:50%;background:var(--accent);margin-right:6px}.back{font-size:12.5px;color:var(--accent);margin-right:5px;flex-shrink:0}.title{position:absolute;left:50%;transform:translateX(-50%);width:calc(100% - 180px);min-width:0;font-weight:600;text-align:center;overflow:hidden;white-space:nowrap;text-overflow:ellipsis;pointer-events:none}.shortcut{font-size:12.5px;color:var(--accent);margin-left:8px;flex-shrink:0}.refresh{width:32px;text-align:right;color:var(--accent);font-size:16px;flex-shrink:0}.bar-cover{line-height:32px}
.bar .back{margin-right:auto}


@media (min-width:500px) and (min-device-width:520px) and (min-device-height:520px) {
  .bar { padding-left:32px; font-size:15px; }
  .brand { font-size:16px; }
  .back, .shortcut { font-size:14px; min-width:44px; min-height:44px; padding:6px 8px; box-sizing:border-box; }
  .refresh { width:44px; text-align:center; }
}
