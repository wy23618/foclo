@import "../../themes/palette.wxss";
:host{display:block}
.chart{width:100%;margin:22rpx 0 30rpx;position:relative}
.chart-compact{margin:10rpx 0 8rpx}
.expand-all-row{display:flex;justify-content:flex-end;margin:0 8rpx 8rpx}
.chart-compact .expand-all-row{margin-bottom:4rpx}
.expand-all-button{padding:5rpx 12rpx;border:1rpx solid var(--border);border-radius:999rpx;color:var(--accent);background:var(--bg-control-soft);font-size:21rpx;line-height:1.35}
.expand-all-button-hover{opacity:.7}
.chart-viewport{width:100%;position:relative;overflow:hidden}
.chart-empty-overlay{position:absolute;left:0;right:0;top:0;bottom:0;z-index:5;display:flex;flex-direction:column;align-items:center;justify-content:center;background:var(--bg-card);border-radius:24rpx}
.chart-empty-ring{width:180rpx;height:180rpx;border-radius:50%;border:14rpx solid var(--chart-empty-border)}
.chart-empty-text{margin-top:24rpx;font-size:24rpx;color:var(--text-muted)}

.render-canvas,.render-snapshot{position:absolute;left:0;top:0;display:block;width:100%;height:100%;}
.render-canvas{z-index:1}
.render-snapshot{z-index:2;pointer-events:none}
.chart-hint{font-size:20rpx;color:var(--text-muted);text-align:center;line-height:1.6;padding-top:8rpx}
.chart-detail{margin-top:20rpx;padding:20rpx 24rpx;border-radius:18rpx;background:var(--bg-control-soft);font-size:23rpx;line-height:1.8;color:var(--text-secondary);overflow-wrap:anywhere}
.detail-name{color:var(--text-primary);font-weight:600}

.layout-error{text-align:center;color:var(--text-muted);font-size:23rpx}
.detail-member{border-top:1rpx solid var(--divider);padding-top:10rpx;margin-top:10rpx}
.full-overlay{position:fixed;left:0;top:0;right:0;bottom:0;width:100vw;height:100vh;z-index:99999;background:var(--bg-chart-full);overflow:hidden}
.full-canvas{display:block;touch-action:none}
