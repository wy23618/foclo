<view wx:if="{{sheetOpenMounted}}" class="picker-overlay {{sheetOpenLeaving ? 'picker-leaving' : ''}} theme-{{theme}}" style="--picker-unit:{{pickerScale}}px;top:{{overlayTop}}px;bottom:{{overlayBottom}}px" catchtouchmove="noop">
  <view class="picker-mask" bindtap="close"></view>
  <view class="picker-card" style="height:{{cardHeight}}px">
    <view class="picker-head">
      <view class="picker-heading">
        <view class="picker-title">{{newOpen ? (editorMode === 'delete' ? '删除项目' : '添加项目') : '选择专注内容'}}</view>
        <view class="picker-subtitle">{{newOpen ? (editorMode === 'delete' ? '确认本次删除的内容' : '给接下来的投入起个名字') : organizing ? '就地添加与删除，完成后继续选择' : '展开分类，选择具体的专注内容'}}</view>
      </view>
      <view class="picker-close" bindtap="close" hover-class="picker-pressed" aria-role="button" aria-label="{{newOpen ? '返回项目列表' : '关闭选择'}}" hover-start-time="0" hover-stay-time="0"><view class="picker-close-icon"></view></view>
    </view>
    <view class="picker-toolbar">
      <block wx:if="{{!newOpen}}">
        <button class="picker-add" bindtap="newProject" disabled="{{loading || creating}}" hover-class="picker-pressed" hover-start-time="0" hover-stay-time="0"><text class="picker-plus">＋</text>添加项目</button>
        <button class="picker-organize {{organizing ? 'picker-organize-on' : ''}}" bindtap="toggleOrganize" disabled="{{loading || creating}}" hover-class="picker-pressed" hover-start-time="0" hover-stay-time="0">{{organizing ? '完成整理' : '整理'}}</button>
      </block>
      <view wx:else class="picker-back" bindtap="cancelNew" aria-role="button" aria-label="返回项目列表" hover-class="picker-pressed" hover-start-time="0" hover-stay-time="0"><view class="picker-chevron picker-chevron-back"></view><text>返回项目列表</text></view>
    </view>
    <scroll-view scroll-y scroll-top="{{listScrollTop}}" bindscroll="onListScroll" class="picker-body" style="height:{{bodyHeight}}px" enhanced show-scrollbar="{{false}}">
      <view wx:if="{{newOpen}}" class="picker-editor">
        <block wx:if="{{editorMode === 'delete'}}"><view class="picker-delete-name">{{editorLabel}}</view><view class="picker-delete-message">{{deleteText}}</view></block>
        <block wx:else>
          <view class="picker-field-label">项目名称</view>
          <input class="picker-name-input" value="{{newName}}" bindinput="inputName" maxlength="120" placeholder="例如：微积分" cursor-spacing="24" adjust-position confirm-type="done" bindconfirm="create" disabled="{{creating}}"/>
          <view class="picker-field-label">所属项目</view>
          <picker range="{{parentOptions}}" range-key="label" value="{{parentIndex}}" bindchange="chooseParent" disabled="{{creating}}"><view class="picker-parent-input"><text>{{parentLabel}}</text><view class="picker-chevron picker-chevron-down"></view></view></picker>
          <view class="picker-form-hint">独立项目可以直接选择；添加下级后，点父项展开。</view>
        </block>
      </view>
      <block wx:else>
        <view wx:if="{{loading}}" class="picker-message">正在读取项目…</view>
        <view wx:elif="{{error}}" class="picker-message" bindtap="load" hover-class="picker-pressed" hover-start-time="0" hover-stay-time="0">{{error}}<view class="picker-retry">点击重新读取</view></view>
        <view wx:else class="picker-list">
          <view wx:for="{{rows}}" wx:key="projectId" id="picker-row-{{item.projectId}}" class="picker-row-group {{item.depth ? 'picker-row-child' : 'picker-row-root'}}" style="padding-left:{{item.indent * pickerScale}}px">
            <view class="picker-row {{item.childCount ? 'picker-row-branch' : 'picker-row-leaf'}} {{selected===item.projectId && !item.childCount ? 'picker-row-selected' : ''}}">
              <view class="picker-row-main" data-id="{{item.projectId}}" bindtap="rowTap" hover-class="picker-row-pressed" aria-role="button" aria-label="{{item.childCount ? (item.expanded ? '收起' : '展开') : organizing ? '项目' : '选择'}}{{item.name}}" hover-start-time="0" hover-stay-time="0">
                <view wx:if="{{item.childCount}}" class="picker-folder" style="color:{{item.color}}"></view><view wx:else class="picker-dot" style="background:{{item.color}}"></view><text class="picker-row-name">{{item.name}}</text>
                <text wx:if="{{createdId===item.projectId}}" class="picker-new-label">新建</text>
                <text wx:if="{{item.childCount}}" class="picker-count">{{item.childCount}} 项</text>
                <view wx:if="{{item.childCount}}" class="picker-chevron {{item.expanded ? 'picker-chevron-open' : ''}}"></view>
                <view wx:elif="{{selected===item.projectId}}" class="picker-check"></view>
              </view>
              <view wx:if="{{organizing}}" class="picker-row-actions">
                <button class="picker-child-add" data-id="{{item.projectId}}" catchtap="newProject" aria-label="在{{item.name}}中添加子项目" disabled="{{creating}}" hover-class="picker-pressed" hover-start-time="0" hover-stay-time="0">＋</button>
                <button class="picker-row-delete" data-id="{{item.projectId}}" catchtap="askDelete" aria-label="删除{{item.name}}" disabled="{{creating}}" hover-class="picker-pressed" hover-start-time="0" hover-stay-time="0"><view class="picker-minus"></view></button>
              </view>
            </view>
          </view>
          <view wx:if="{{!rows.length}}" class="picker-empty"><view class="picker-empty-title">从一件想做的事开始</view><view>点击上方“添加项目”</view></view>
        </view>
      </block>
    </scroll-view>
    <view class="picker-footer">
      <block wx:if="{{newOpen}}"><button class="picker-cancel" bindtap="cancelNew" disabled="{{creating}}" hover-class="picker-pressed" hover-start-time="0" hover-stay-time="0">取消</button><button wx:if="{{editorMode === 'delete'}}" class="picker-submit picker-delete-confirm" bindtap="confirmDelete" loading="{{creating}}" disabled="{{creating}}" hover-class="picker-pressed" hover-start-time="0" hover-stay-time="0">确认删除</button><button wx:else class="picker-submit" bindtap="create" loading="{{creating}}" disabled="{{creating || !newName}}" hover-class="picker-pressed" hover-start-time="0" hover-stay-time="0">添加项目</button></block>
      <block wx:else><view class="picker-manage-entry" bindtap="goManage" hover-class="picker-pressed" aria-role="button" aria-label="打开项目管理" hover-start-time="0" hover-stay-time="0"><text>项目管理</text><view class="picker-chevron"></view></view><text class="picker-footer-note">{{organizing ? '＋ 添加下级　− 删除' : '选好后即可开始'}}</text></block>
    </view>
  </view>
</view>
