<page-meta page-style="{{themePageStyle}}"/>
<view class="guide-page theme-{{themeClass}}">
  <view class="guide-hero">
    <text class="guide-brand">YoTick · 小小入门卡</text>
    <view class="guide-title">先专注一小会儿。</view>
    <view class="guide-subtitle">三张卡片，就会用了。</view>
  </view>
  <swiper class="guide-deck" current="{{cardIndex}}" bindchange="onCardChange" indicator-dots indicator-color="{{indicatorColor}}" indicator-active-color="{{indicatorActiveColor}}">
    <swiper-item wx:for="{{quickSteps}}" wx:key="number">
      <view class="starter-card">
        <view class="starter-top"><text>开始的小步骤</text><text>{{item.number}} / 03</text></view>
        <view class="starter-symbol">{{item.symbol}}</view>
        <view class="starter-preview preview-{{index}}">{{item.preview}}</view>
        <view class="starter-title">{{item.title}}</view>
        <view class="starter-text">{{item.text}}</view>
      </view>
    </swiper-item>
  </swiper>
  <button class="guide-start" bindtap="startFocus">去专注一下 →</button>
  <view class="tips-label">用到时，再看一眼</view>
  <view class="guide-tips">
    <view wx:for="{{chapters}}" wx:key="id" id="guide-{{item.id}}" class="tip-card">
      <view class="tip-heading" data-id="{{item.id}}" bindtap="toggleChapter"><text class="tip-symbol">{{item.symbol}}</text><text class="tip-title">{{item.title}}</text><text class="tip-expand">{{opened[item.id] ? '−' : '+'}}</text></view>
      <view wx:if="{{opened[item.id]}}" class="tip-content">{{item.tip}}</view>
    </view>
  </view>
  <view class="guide-end">慢慢来，每一次专注都算数。</view>
</view>
