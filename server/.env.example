NODE_ENV=development
HOST=0.0.0.0
PORT=3000
DATABASE_URL=postgresql://yotick_app:replace-me@localhost:5432/yotick
MIGRATION_DATABASE_URL=postgresql://yotick_migrator:replace-me@localhost:5432/yotick
DATABASE_SSL=true
# PEM CA certificate for the PostgreSQL server; leave empty to use system trust roots.
DATABASE_CA=
WECHAT_APP_ID=replace-me
WECHAT_APP_SECRET=replace-me
# Use independent random secrets of at least 32 characters. Never commit real values.
TOKEN_PEPPER=replace-with-at-least-32-random-characters
CURSOR_SECRET=replace-with-a-different-32-random-characters
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
REFRESH_GRACE_SECONDS=30
DB_POOL_MAX=10
