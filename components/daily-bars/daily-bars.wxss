@import "../../themes/tablet-inline.wxss";
.bars-scroll { width: 100%; }

.bars {
  display: flex;
  align-items: flex-end;
  padding: 8rpx 4rpx 0;
}

.bar-col {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 86rpx;
  flex: 1 0 86rpx;
  padding-top: 20rpx;
}

.bar-col:last-child { margin-right: 0; }

.bar-top {
  font-size: 21rpx;
  font-weight: 600;
  color: var(--text-secondary);
  white-space: nowrap;
  height: 32rpx;
  line-height: 32rpx;
  font-variant-numeric: tabular-nums;
}

.bar-top-zero { color: var(--text-muted); font-weight: 400; }

.bar-plot {
  height: 180rpx;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  width: 100%;
}

.bar-fill {
  width: 26rpx;
  border-radius: 12rpx 12rpx 0 0;
  background: var(--accent);
  min-height: 0;
}

.bar-date {
  margin-top: 10rpx;
  font-size: 21rpx;
  color: var(--text-muted);
  white-space: nowrap;
  font-variant-numeric: tabular-nums;
}
.bar-col{position:relative;padding-top:36rpx}.bar-top{position:absolute;}
/* tablet-generated:start */
/* Generated by scripts/build-tablet-styles.js; edit the original rules above. */
@media (min-width:500px) and (min-device-width:520px) and (min-device-height:520px){
.bars-scroll{width: 100%;}
.bars{display: flex;
  align-items: flex-end;
  padding: 4.8px 2.4px 0;}
.bar-col{display: flex;
  flex-direction: column;
  align-items: center;
  width: 51.6px;
  flex: 1 0 51.6px;
  padding-top: 12px;}
.bar-col:last-child{margin-right: 0;}
.bar-top{font-size: 12.6px;
  font-weight: 600;
  color: var(--text-secondary);
  white-space: nowrap;
  height: 19.2px;
  line-height: 19.2px;
  font-variant-numeric: tabular-nums;}
.bar-top-zero{color: var(--text-muted); font-weight: 400;}
.bar-plot{height: 108px;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  width: 100%;}
.bar-fill{width: 15.6px;
  border-radius: 7.2px 7.2px 0 0;
  background: var(--accent);
  min-height: 0;}
.bar-date{margin-top: 6px;
  font-size: 12.6px;
  color: var(--text-muted);
  white-space: nowrap;
  font-variant-numeric: tabular-nums;}
.bar-col{position:relative;padding-top:21.6px}
.bar-top{position:absolute;}
}
/* tablet-generated:end */
/* A taller plot balances the adjacent populated distribution chart. */
@media (min-width:680px) and (min-device-width:520px) and (min-device-height:520px) and (orientation:landscape) {
  .bars-landscape { --landscape-plot:clamp(140px,calc(30vw - 160px),240px); }
  .bars-landscape .bar-plot { height:var(--landscape-plot); }
  .bars-landscape .bar-fill { height:calc(var(--bar-ratio) * var(--landscape-plot)) !important; max-height:240px; width:20px; border-radius:8px 8px 0 0; }
  .bars-landscape .bar-top { bottom:calc(var(--bar-ratio) * var(--landscape-plot) + 25.2px) !important; }
}
