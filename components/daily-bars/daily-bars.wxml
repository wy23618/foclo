<view class="bars-scroll-wrap {{landscapeLayout?'bars-landscape':''}}"><scroll-view scroll-x scroll-into-view="{{scrollTarget}}" scroll-with-animation="{{false}}" class="bars-scroll" enhanced show-scrollbar="{{false}}">
  <view class="tablet-inline bars" style="--tablet-value-min-width:calc({{plotWidth}} * .6px);min-width:var(--tablet-length-min-width, {{plotWidth}}rpx)">
    <view wx:for="{{cols}}" wx:key="date" id="{{item.anchor}}" class="bar-col" data-date="{{item.date}}" bindtap="selectDay">
      <view class="tablet-inline bar-top {{item.positive ? '' : 'bar-top-zero'}}" style="--bar-ratio:{{item.barH / 180}};--tablet-value-bottom:calc({{item.barH+42}} * .6px);bottom:var(--tablet-length-bottom, {{item.barH+42}}rpx)">{{item.label}}</view>
      <view class="bar-plot">
        <view class="tablet-inline bar-fill" style="--bar-ratio:{{item.barH / 180}};--tablet-value-height:calc({{item.barH}} * .6px);height:var(--tablet-length-height, {{item.barH}}rpx);"></view>
      </view>
      <view class="bar-date">{{item.md}}</view>
    </view>
  </view>
</scroll-view></view>
