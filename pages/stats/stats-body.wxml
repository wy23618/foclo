<safe-nav id="safeNav" theme="{{themeClass}}" title="专注统计" back-text="‹ 返回" bindback="goBack" hidden="{{rangeOpen || chartFull}}" bindheightchange="onNavHeightChange"/>
<view class="container with-tabbar {{landscapeLayout?'landscape-shell':''}} stats-layout {{landscapeLayout?'landscape-dashboard':''}} {{chartTree.length?'stats-layout-with-projects':''}} theme-{{themeClass}}">
  <view class="landscape-only landscape-heading"><view class="landscape-title">专注统计</view><view class="landscape-subtitle">看见投入，也看见自己的节奏。</view></view>
  <view class="stats-sticky-controls" style="top:{{filterTop}}px">
    <button class="subject-entry" catchtap="openSubjects" hover-class="subject-entry-pressed"><text>全部项目</text><text>切换 ▾</text></button>
    <view class="filter-row"><view class="flex-1"><segmented id="rangeTabs" items="{{rangeItems}}" selected="{{preset}}" bindchange="onRangeChange" /></view><view class="heat-btn" bindtap="goHeatmap"><view class="heat-grid"><view wx:for="{{[1,2,3,4,5,6,7,8,9]}}" wx:key="*this" class="hg-dot"></view></view><text class="heat-label">热力图</text></view></view>
  </view>
  
  <view wx:if="{{preset === 'custom'}}" class="range-edit" bindtap="openRange">{{rangeText}} 修改 ▾</view>
  <view wx:if="{{error}}" class="card error-card"><view>{{error}}</view><button class="btn btn-ghost btn-sm mt-sm" bindtap="refresh">重新读取</button></view>
  <block wx:if="{{landscapeLayout}}">
    <include src="stats-summary.wxml"/>
    <include src="stats-goal.wxml"/>
    <view class="landscape-chart-board {{preset === 'today'?'landscape-chart-today':''}}">
      <include src="stats-distribution.wxml"/>
      <include src="stats-daily.wxml"/>
      <include src="stats-slots.wxml"/>
      <include src="stats-records.wxml"/>
    </view>
    <include src="stats-projects.wxml"/>
  </block>
  <block wx:else>
    <include src="stats-summary.wxml"/><include src="stats-goal.wxml"/><include src="stats-distribution.wxml"/><include src="stats-projects.wxml"/><include src="stats-daily.wxml"/><include src="stats-slots.wxml"/><include src="stats-records.wxml"/>
  </block>
</view>
<date-range theme="{{themeClass}}" id="dateRange" opened="{{rangeOpen}}" start="{{startDate}}" end="{{endDate}}" bindclose="closeRange" bindconfirm="confirmRange" />
<page-container show="{{heatmapOpen||scopeOpen}}" position="center" duration="0" z-index="600" overlay="{{scopeOpen}}" close-on-slide-down="{{false}}" custom-style="height:100%;width:100%;background:transparent;overflow:visible" overlay-style="background:rgba(24,32,23,.4)" bindclickoverlay="onOverlayClick" bindbeforeleave="onOverlayBeforeLeave" bindafterleave="onOverlayAfterLeave">
  <subject-picker id="subjectPicker" opened="{{scopeOpen}}" rows="{{subjectOptions}}" theme="{{themeClass}}" bindclose="closeSubjects" bindafterclose="onSubjectsAfterClose" bindselect="chooseSubject"/>
  <heatmap-card demo-session="{{demoSession}}" opened="{{heatmapOpen}}" theme="{{themeClass}}" top-inset="{{filterTop}}" bindclose="closeHeatmap"/>
</page-container>
<main-nav landscape-layout="{{landscapeLayout}}" demo-session="{{demoSession}}" selected="{{1}}" theme="{{themeClass}}" hidden="{{rangeOpen||chartFull||heatmapOpen||scopeOpen}}"/>
