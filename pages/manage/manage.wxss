.manage-page{min-height:100vh;padding-bottom:calc(40rpx + env(safe-area-inset-bottom))}
.mg-toolbar{position:sticky;top:0;z-index:20;display:flex;align-items:center;justify-content:space-between;gap:16rpx;margin:-4rpx -2rpx 14rpx;padding:10rpx 2rpx 12rpx;background:var(--bg-page)}
.mg-intro{min-width:0;color:var(--text-secondary);font-size:23rpx;line-height:1.4}
.mg-search-toggle{flex-shrink:0;display:flex;align-items:center;gap:12rpx;min-height:66rpx;padding:0 20rpx;border-radius:20rpx;background:var(--bg-card);border:1rpx solid var(--border);color:var(--accent);font-size:23rpx;font-weight:650}
.mg-search-icon{position:relative;width:20rpx;height:20rpx;border:3rpx solid currentColor;border-radius:50%;box-sizing:border-box}
.mg-search-icon::after{content:'';position:absolute;right:-10rpx;bottom:-5rpx;width:10rpx;height:3rpx;border-radius:3rpx;background:currentColor;transform:rotate(46deg)}
.mg-tab{margin-bottom:18rpx}
.mg-search-field{display:flex;align-items:center;gap:20rpx;height:84rpx;box-sizing:border-box;margin:0 0 18rpx;padding:0 24rpx;border:1rpx solid var(--border);border-radius:22rpx;background:var(--bg-card);color:var(--text-muted)}
.mg-search-input{flex:1;min-width:0;height:78rpx;color:var(--text-primary);font-size:26rpx}
.mg-search-clear{flex-shrink:0;color:var(--accent);font-size:23rpx}
.mg-search-count{margin:0 2rpx 16rpx;color:var(--text-muted);font-size:22rpx}
.mg-list{overflow:visible;padding:0 24rpx;border:1rpx solid var(--border);border-radius:28rpx;background:var(--bg-card)}
.mg-item{position:relative;display:flex;align-items:center;gap:12rpx;min-height:106rpx;padding:14rpx 0;box-sizing:border-box;border-bottom:1rpx solid var(--divider)}
.mg-item:last-child{border-bottom:0}
.mg-item-dragging{z-index:40;border-radius:18rpx;background:var(--bg-card);box-shadow:0 12rpx 36rpx rgba(32,48,38,.17);opacity:.94}
.mg-item-shifting{transition:transform .18s cubic-bezier(.2,.75,.25,1)}
.mg-item-settling{transition:transform .18s cubic-bezier(.2,.75,.25,1)}
.mg-item-drop-before::before,.mg-item-drop-after::after{content:'';position:absolute;left:8rpx;right:8rpx;height:4rpx;border-radius:99rpx;background:var(--accent)}
.mg-item-drop-before::before{top:-2rpx}
.mg-item-drop-after::after{bottom:-2rpx}
.mg-item-root .mg-name{font-weight:720}
.mg-tree-toggle{display:flex;align-items:center;justify-content:center;flex-shrink:0;width:42rpx;height:64rpx;color:var(--accent);font-size:34rpx;font-weight:600}
.mg-tree-empty{color:transparent}
.mg-main{flex:1;min-width:0;padding:7rpx 0}
.mg-name-line{display:flex;align-items:center;min-width:0}
.mg-name{color:var(--text-primary);font-size:28rpx;font-weight:650}
.mg-meta{margin-top:5rpx;color:var(--text-muted);font-size:21rpx}
.mg-appearance-trigger,.mg-menu{display:flex;align-items:center;justify-content:center;flex-shrink:0;width:66rpx;height:66rpx;border-radius:19rpx}
.mg-appearance-trigger{width:126rpx;min-height:88rpx;gap:10rpx;padding:0 14rpx;box-sizing:border-box;background:var(--bg-control-soft);color:var(--text-secondary);font-size:22rpx;font-weight:600}
.mg-appearance-trigger:active{background:var(--bg-control);transform:scale(.97)}
.mg-color{width:31rpx;height:31rpx;flex:none;border-radius:50%;border:3rpx solid var(--bg-card);box-shadow:0 0 0 1rpx var(--border)}
.mg-menu{color:var(--text-secondary);font-size:28rpx;font-weight:700;letter-spacing:-5rpx;line-height:1}
.mg-empty,.mg-no-results{border:1rpx solid var(--border);border-radius:28rpx;background:var(--bg-card)}
.mg-no-results{padding:82rpx 24rpx;text-align:center;color:var(--text-primary);font-size:27rpx;font-weight:600}
.mg-no-results-hint{margin-top:8rpx;color:var(--text-muted);font-size:22rpx;font-weight:400}
.mg-loading{padding:90rpx 0;color:var(--text-muted);font-size:24rpx;text-align:center}
.rename-mask{position:fixed;z-index:100;inset:0;display:flex;align-items:center;justify-content:center;padding:40rpx;box-sizing:border-box;background:rgba(20,27,21,.38)}
.rename-sheet{width:100%;max-width:620rpx;padding:34rpx 32rpx 30rpx;box-sizing:border-box;border:1rpx solid var(--border);border-radius:30rpx;background:var(--bg-card);box-shadow:0 24rpx 70rpx rgba(26,38,29,.2);animation:rename-card-in .18s ease-out}
.rename-title{color:var(--text-primary);font-size:34rpx;font-weight:750}
.rename-hint{margin-top:8rpx;color:var(--text-muted);font-size:22rpx}
.rename-input-wrap{display:flex;align-items:center;gap:16rpx;margin-top:28rpx;padding:0 20rpx;border:2rpx solid var(--accent);border-radius:20rpx;background:var(--bg-control-soft)}
.rename-input{flex:1;min-width:0;height:92rpx;color:var(--text-primary);font-size:30rpx;font-weight:600}
.rename-count{flex-shrink:0;color:var(--text-muted);font-size:20rpx;font-variant-numeric:tabular-nums}
.rename-actions{display:flex;gap:18rpx;margin-top:28rpx}
.rename-button{display:flex;align-items:center;justify-content:center;height:84rpx;margin:0;border-radius:22rpx;font-size:27rpx;font-weight:700;line-height:1}
.rename-button::after{border:0}
.rename-cancel{width:210rpx;background:var(--bg-control-soft);color:var(--text-secondary)}
.rename-save{flex:1;background:var(--accent);color:var(--text-on-accent)}
.rename-save[disabled]{background:var(--border);color:var(--text-muted)}
@keyframes rename-card-in{from{transform:scale(.96);opacity:.35}to{transform:scale(1);opacity:1}}

