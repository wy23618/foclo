.tablet-focus .focus-controls .presets { gap:6px; }
.tablet-focus .focus-controls .preset { min-height:44px; padding:8px 4px; background:var(--bg-card); border:1px solid var(--border); font-size:15px; font-weight:500; font-variant-numeric:tabular-nums; border-radius:11px; }
.tablet-focus .focus-controls .preset-on { background:var(--accent-soft); border-color:var(--accent); color:var(--accent); font-weight:600; }
.tablet-focus .focus-modes { margin-top:10px; padding:3px; border:1px solid var(--border); border-radius:13px; background:var(--bg-control-soft); gap:4px; }
.tablet-focus .focus-mode { min-height:44px; padding:6px; font-size:13px; border-radius:9px; }
.tablet-focus .focus-mode-on { background:var(--bg-card); color:var(--accent); font-weight:600; box-shadow:0 2px 8px rgba(25,40,28,.04); }
.tablet-focus .runtime-tools { display:grid; grid-template-columns:minmax(0,1fr) minmax(0,1fr); gap:10px; margin:0; flex-shrink:0; }
.tablet-focus .runtime-tool { flex-basis:auto; min-height:44px; padding:8px; font-size:13px; border-radius:12px; }
.tablet-focus .actions { margin:0; flex-shrink:0; }
.tablet-focus .actions .btn { min-height:50px; padding:10px; font-size:15px; border-radius:13px; }
.tablet-focus .landscape-session-summary { display:flex; align-items:center; gap:12px; justify-content:space-between; margin:0; padding-top:12px; border-top:1px solid var(--divider); flex-shrink:0; }
.tablet-focus .landscape-today-copy { display:flex; flex-direction:row; align-items:baseline; gap:8px; min-width:0; }
.tablet-focus .landscape-today-label { font-size:12px; color:var(--text-secondary); flex:none; }
.tablet-focus .landscape-today-value { font-size:16px; font-weight:600; overflow-wrap:anywhere; }
.tablet-focus .landscape-today-link { flex:none; min-height:36px; padding:6px 0; margin:0; display:flex; align-items:center; font-size:11px; line-height:1.4; color:var(--accent); background:transparent; }
.tablet-focus .landscape-today-link::after { border:0; }
.tablet-focus .goal-progress { margin:0; padding:0; flex-shrink:0; }
.tablet-focus .goal-progress-top { font-size:12px; }
.tablet-focus .goal-progress-title, .tablet-focus .goal-progress-value { font-size:12px; }
.tablet-focus .guest-hint { display:flex; align-items:center; justify-content:space-between; gap:8px; margin:0; padding:6px 8px; border-radius:12px; background:var(--bg-control-soft); border:0; flex-shrink:0; }
.tablet-focus .guest-hint-copy { min-width:0; }
.tablet-focus .guest-hint-title { font-size:11px; line-height:1.5; }
.tablet-focus .guest-hint-description { font-size:12px; }
.tablet-focus .guest-hint-actions { flex:none; margin:0; gap:4px; }
.tablet-focus .guest-hint-login { min-width:44px; min-height:44px; font-size:12px; }
.tablet-focus .guest-hint-login text { display:none; }
.tablet-focus .guest-hint-close { min-width:44px; min-height:44px; padding:4px!important; margin:0!important; font-size:20px; }
/* Compact tablet surfaces, using the existing theme palette. */
@media (min-width:500px) and (min-device-width:520px) and (min-device-height:520px) {
  .tablet-focus .landscape-session-summary { display:block; position:relative; min-width:0; width:100%; box-sizing:border-box; }
  .tablet-focus .landscape-today-copy { display:block; width:100%; min-width:0; }
  .tablet-focus .landscape-today-label { display:block; padding-right:82px; font-size:11px; line-height:20px; }
  .tablet-focus .landscape-today-value { display:block; margin-top:4px; width:100%; font-size:17px; line-height:24px; white-space:nowrap; overflow-wrap:normal; word-break:keep-all; }
  .tablet-focus .landscape-today-link { position:absolute; top:4px; right:0; width:80px; min-width:0; height:36px; padding:0; margin:0; justify-content:flex-end; font-size:11px; white-space:nowrap; }
  .tablet-focus .focus-dock { border-radius:16px; padding:16px; gap:12px; }
  .tablet-focus .focus-stage .dial { box-shadow:0 6px 20px rgba(25,40,28,.035); }
}
