<view class="container {{landscapeLayout?'landscape-shell':''}} landscape-detail manage-page theme-{{themeClass}}">
  <view class="mg-heading"><view><view class="mg-title">我的项目</view><view class="mg-intro">{{sorting ? '长按右侧手柄，拖动调整同级顺序' : '点名称编辑，点箭头展开下级'}}</view></view><button class="mg-new" bindtap="newProject" disabled="{{loading || editorSaving || draggingId}}" hover-class="mg-pressed" hover-start-time="0" hover-stay-time="0">＋ 新建</button></view>
  <view class="mg-toolbar">
    <view class="mg-tab"><segmented items="{{tabItems}}" selected="{{tab}}" bindchange="switchTab" /></view>
    <view class="mg-tools"><button class="mg-tool {{searchOpen ? 'mg-tool-on' : ''}}" bindtap="toggleSearch" disabled="{{!!draggingId}}" aria-label="搜索项目" hover-class="mg-pressed" hover-start-time="0" hover-stay-time="0"><view class="mg-search-icon"></view></button><button class="mg-sort {{sorting ? 'mg-tool-on' : ''}}" bindtap="toggleSorting" disabled="{{loading || !!draggingId}}" hover-class="mg-pressed" hover-start-time="0" hover-stay-time="0">{{sorting ? '完成' : '排序'}}</button></view>
  </view>
  <view wx:if="{{searchOpen}}" class="mg-search-field"><view class="mg-search-icon"></view><input class="mg-search-input" value="{{searchQuery}}" focus="{{searchFocus}}" confirm-type="search" placeholder="搜索名称或上级项目" bindinput="inputSearch"/><view wx:if="{{searchQuery}}" class="mg-search-clear" bindtap="clearSearch" hover-class="mg-pressed" hover-start-time="0" hover-stay-time="0">清除</view></view>
  <view wx:if="{{searchQuery}}" class="mg-search-count">找到 {{visibleRows.length}} 个项目</view>
  <view wx:if="{{loading}}" class="mg-loading">正在读取项目…</view>
  <view wx:elif="{{searchQuery && !visibleRows.length}}" class="mg-empty"><view class="mg-empty-title">没有找到相关项目</view><view>试试项目名称或上级名称</view></view>
  <view wx:elif="{{!visibleRows.length}}" class="mg-empty"><view class="mg-empty-mark">{{tab === 'active' ? '＋' : '—'}}</view><view class="mg-empty-title">{{tab === 'active' ? '从一件想做的事开始' : '暂无归档项目'}}</view><view>{{tab === 'active' ? '点击右上角“新建”，添加你的专注内容' : '暂时告一段落的项目，可以收纳在这里'}}</view></view>
  <view wx:else class="mg-list">
    <view wx:for="{{visibleRows}}" wx:key="projectId" class="tablet-inline mg-item {{item.childCount ? 'mg-item-branch' : 'mg-item-leaf'}} {{item.indent === 0 ? 'mg-item-root' : ''}} {{draggingId === item.projectId ? 'mg-item-dragging' : ''}} {{draggingId && draggingId !== item.projectId ? 'mg-item-shifting' : ''}} {{sortSettling && draggingId === item.projectId ? 'mg-item-settling' : ''}} {{dropTargetId === item.projectId ? (dropAfter ? 'mg-item-drop-after' : 'mg-item-drop-before') : ''}}" style="--tablet-value-padding-left:calc({{item.indent}} * .6px);padding-left:var(--tablet-length-padding-left, {{item.indent}}rpx);transform:translateY({{draggingId === item.projectId ? dragOffset : (item.sortShift || 0)}}px)">
      <view class="mg-tree-toggle {{item.childCount && !item.searchResult ? '' : 'mg-tree-empty'}}" data-id="{{item.projectId}}" bindtap="toggleGroup" aria-role="button" aria-label="{{item.expanded ? '收起' : '展开'}}{{item.name}}" hover-class="mg-pressed" hover-start-time="0" hover-stay-time="0"><view wx:if="{{item.childCount && !item.searchResult}}" class="mg-chevron {{item.expanded ? 'mg-chevron-open' : ''}}"></view></view>
      <view class="mg-main" data-id="{{item.projectId}}" bindtap="openEditor" hover-class="mg-row-pressed" aria-role="button" aria-label="编辑{{item.name}}" hover-start-time="0" hover-stay-time="0">
        <view wx:if="{{item.childCount}}" class="mg-folder" style="color:{{item.displayColor}}"></view><view wx:else class="mg-color" style="background:{{item.displayColor}}"></view><view class="mg-copy"><view class="mg-name ellipsis">{{item.name}}</view><view class="mg-meta ellipsis">{{item.metaText}}</view></view>
      </view>
      <view wx:if="{{sorting}}" class="mg-drag-handle" data-id="{{item.projectId}}" bindtouchstart="sortTouchStart" bindlongpress="sortLongPress" catchtouchmove="sortTouchMove" bindtouchend="sortTouchEnd" bindtouchcancel="sortTouchCancel" aria-role="button" aria-label="长按拖动{{item.name}}调整同级顺序"><view></view><view></view><view></view></view>
      <view wx:else class="mg-edit-entry" data-id="{{item.projectId}}" bindtap="openEditor" aria-role="button" aria-label="编辑{{item.name}}" hover-class="mg-pressed" hover-start-time="0" hover-stay-time="0">编辑</view>
    </view>
  </view>
</view>
<page-container show="{{editorHistoryOpen}}" overlay="{{false}}" position="center" duration="0" custom-style="width:1px;height:1px;opacity:0;background:transparent" bindafterenter="onEditorHistoryEnter" bindafterleave="onEditorHistoryLeave"><view/></page-container>
<view wx:if="{{editorOpenMounted}}" class="mg-editor-overlay {{editorOpenLeaving ? 'mg-editor-leaving' : ''}} theme-{{themeClass}}" catchtouchmove="noop">
  <view class="mg-editor-mask" bindtap="closeEditor"></view>
  <view class="mg-editor-card {{editorNested ? 'mg-editor-forward' : 'mg-editor-backward'}}">
    <view class="mg-editor-head"><view><view class="mg-editor-kicker">{{editorNested ? '返回后继续编辑「' + editorParentName + '」' : editorKind === 'create' ? '新的专注内容' : editorArchived ? '已归档项目' : '项目设置'}}</view><view class="mg-editor-title">{{editorNested ? '添加子项目' : editorKind === 'create' ? '添加项目' : '编辑项目'}}</view></view><button class="mg-editor-close" bindtap="closeEditor" disabled="{{editorSaving}}" aria-label="{{editorNested ? '返回上一级编辑' : '关闭项目编辑'}}" hover-class="mg-pressed" hover-start-time="0" hover-stay-time="0"><view class="{{editorNested ? 'mg-chevron mg-chevron-back' : 'mg-close-icon'}}"></view></button></view>
    <scroll-view scroll-y enhanced scroll-top="{{editorScrollTop}}" bindscroll="editorScrolled" show-scrollbar="{{false}}" class="mg-editor-body">
      <view class="mg-field-label">项目名称</view>
      <input class="mg-input mg-name-input" value="{{editorName}}" maxlength="120" bindinput="inputEditorName" placeholder="例如：微积分" cursor-spacing="28" adjust-position confirm-type="done" bindconfirm="saveEditor" disabled="{{editorSaving}}"/>
      <view class="mg-field-label">所属项目</view>
      <picker wx:if="{{editorKind === 'create'}}" range="{{parentOptions}}" range-key="label" value="{{parentIndex}}" bindchange="chooseParent" disabled="{{editorSaving}}"><view class="mg-parent-input"><text class="ellipsis">{{parentLabel}}</text><view class="mg-chevron mg-chevron-open"></view></view></picker>
      <view wx:else class="mg-parent-path">{{editorPath}}</view>
      <block wx:if="{{editorKind !== 'create'}}">
        <view class="mg-field-line"><view class="mg-field-label">图表颜色</view><view class="mg-default-color" bindtap="chooseEditorColor" hover-class="mg-pressed" hover-start-time="0" hover-stay-time="0">{{editorColor ? '恢复默认' : '使用默认色'}}</view></view>
        <view class="mg-palette"><view wx:for="{{editorPalette}}" wx:key="*this" class="mg-swatch-target" data-color="{{item}}" bindtap="chooseEditorColor" aria-role="button" aria-label="选择颜色{{item}}" hover-class="mg-pressed" hover-start-time="0" hover-stay-time="0"><view class="mg-swatch {{editorColor === item ? 'mg-swatch-on' : ''}}" style="background:{{item}}"></view></view></view>
        <view class="mg-color-tools"><view class="mg-more-colors" bindtap="toggleEditorPalette" hover-class="mg-pressed" hover-start-time="0" hover-stay-time="0">{{editorPaletteExpanded ? '收起颜色' : '更多颜色'}}</view><view class="mg-more-colors" bindtap="editorAdvancedColor" hover-class="mg-pressed" hover-start-time="0" hover-stay-time="0">自由调色 ›</view></view>
        <view wx:if="{{editorPaletteExpanded}}" class="mg-hex-field"><view class="mg-color-preview" style="background:{{editorPreviewColor}}"></view><input class="mg-hex-input" value="{{editorHex}}" bindinput="inputEditorHex" maxlength="7" placeholder="自选色码，例如 #425B42" cursor-spacing="28" disabled="{{editorSaving}}"/></view>
        <view wx:if="{{editorColorError}}" class="mg-field-error">{{editorColorError}}</view>
        <view class="mg-field-label">图表简称 <text>选填 · 最多 8 字</text></view>
        <input class="mg-input" value="{{editorShortName}}" bindinput="inputEditorShortName" maxlength="8" placeholder="留空时显示项目名称" cursor-spacing="28" disabled="{{editorSaving}}"/>
        <view class="mg-editor-links"><view wx:if="{{!editorArchived}}" class="mg-editor-link" bindtap="editorAddChild" hover-class="mg-pressed" hover-start-time="0" hover-stay-time="0"><text>添加子项目</text><text>＋</text></view><view class="mg-editor-link" bindtap="editorStats" hover-class="mg-pressed" hover-start-time="0" hover-stay-time="0"><text>查看专注统计</text><view class="mg-chevron"></view></view></view>
        <view class="mg-editor-secondary"><button bindtap="editorArchive" disabled="{{editorSaving}}" hover-class="mg-pressed" hover-start-time="0" hover-stay-time="0">{{editorArchived ? '恢复项目' : '归档项目'}}</button><button class="mg-danger" bindtap="editorDelete" disabled="{{editorSaving}}" hover-class="mg-pressed" hover-start-time="0" hover-stay-time="0">删除项目</button></view>
      </block>
    </scroll-view>
    <view class="mg-editor-footer"><button class="mg-editor-cancel" bindtap="closeEditor" disabled="{{editorSaving}}" hover-class="mg-pressed" hover-start-time="0" hover-stay-time="0">{{editorNested ? '返回编辑' : '取消'}}</button><button class="mg-editor-save" bindtap="saveEditor" loading="{{editorSaving}}" disabled="{{editorSaving || !editorName || editorColorError}}" hover-class="mg-pressed" hover-start-time="0" hover-stay-time="0">{{editorKind === 'create' ? '添加项目' : '保存修改'}}</button></view>
  </view>
</view>
