@import "../stats/stats.wxss";
.day-summary-card{padding:26rpx 28rpx 24rpx;border-radius:34rpx;box-shadow:0 10rpx 30rpx rgba(32,48,71,.05)}
.day-date-nav { display: flex; align-items: center; gap: 6rpx; flex-shrink:0; }
.day-date-arrow { width: 34rpx; height: 48rpx; flex-shrink: 0; display: flex; align-items: center; justify-content: center; border-radius: 14rpx; background: var(--bg-control-soft); color: var(--accent); font-size: 31rpx; }
.day-date-arrow.disabled { opacity: .35; }
.day-date-picker { min-width: 0; }
.day-date-picker .summary-period { white-space: nowrap; }
.day-date-caret { margin-left: 3rpx; color: var(--text-muted); font-size: 19rpx; }
.day-distribution { padding-bottom: 18rpx; }
.day-records { margin-bottom: 20rpx; }
/* tablet-generated:start */
/* Generated by scripts/build-tablet-styles.js; edit the original rules above. */
@media (min-width:500px) and (min-device-width:520px) and (min-device-height:520px){
.day-summary-card{padding:15.6px 16.8px 14.4px;border-radius:20.4px;box-shadow:0 6px 18px rgba(32,48,71,.05)}
.day-date-nav{display: flex; align-items: center; gap: 3.6px; flex-shrink:0;}
.day-date-arrow{width: 20.4px; height: 28.8px; flex-shrink: 0; display: flex; align-items: center; justify-content: center; border-radius: 8.4px; background: var(--bg-control-soft); color: var(--accent); font-size: 18.6px;}
.day-date-arrow.disabled{opacity: .35;}
.day-date-picker{min-width: 0;}
.day-date-picker .summary-period{white-space: nowrap;}
.day-date-caret{margin-left: 1.8px; color: var(--text-muted); font-size: 11.4px;}
.day-distribution{padding-bottom: 10.8px;}
.day-records{margin-bottom: 12px;}
}
/* tablet-generated:end */