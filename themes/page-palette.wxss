/* Global page defaults split from palette.wxss so component styles never parse a page tag selector. */
page {
  --bg-page: #F5F7EF;
  --bg-card: #FFFFFF;
  --bg-surface-soft: #FBFAF7;
  --bg-control: #E8EDE2;
  --bg-control-soft: #EFF3E9;
  --accent: #4D654D;
  --accent-pressed: #415641;
  --accent-soft: #E2EBDF;
  --accent-muted: #D5E2CD;
  --action-primary: #4D654D;
  --action-primary-pressed: #415641;
  --text-on-accent: #FFFFFF;
  --text-primary: #203047;
  --text-secondary: #6E746E;
  --text-muted: #9A9E96;
  --border: #E7E3DB;
  --divider: #EFEBE2;
  --border-accent: #DCE5D6;
  --bg-nested: #F3F6EE;
  --border-nested: #E4EADD;
  --border-tree: #CBD9C3;
  --bg-tag: #E4EBDD;
  --text-tag: #607655;
  --bg-tag-muted: #F1EEE8;
  --text-tag-muted: #96968B;
  --bg-note: #F0F3EA;
  --bg-input: #F0ECE1;
  --action-secondary: #ECE7DE;
  --text-control: #2C2C28;
  --control-handle: #D2D2C9;
  --control-off: #D9DDD5;
  --control-thumb: #FFFFFF;
  --status-paused: #B58B55;
  --danger-bg: #F7E9E4;
  --danger-bg-pressed: #F0D9D1;
  --danger-text: #A84A32;
  --danger-border: #EDCEC6;
  --danger-text-strong: #A84A32;
  --warning-bg: #FBF6EC;
  --tabbar-bg: rgba(255,255,255,.96);
  --tabbar-border: #EDF0E9;
  --tabbar-text: #9DA5B1;
  --tabbar-active: #4D654D;
  --bg-selected: #EEF4E8;
  --summary-tag-bg: #F2F4EB;
  --summary-tag-text: #526950;
  --summary-surface: linear-gradient(135deg,#F1F5E9,#F7F8F0);
  --summary-caption: #6F826C;
  --summary-unit: #6E806D;
  --summary-range: #89988A;
  --summary-track: #E3E9DF;
  --summary-fill: #527356;
  --bg-toolbar: #F6F4EE;
  --toolbar-shadow: rgba(246,244,238,.9);
  --bg-chart-control: #EEF3EB;
  --chart-axis: #879587;
  --chart-border: #E5EBE5;
  --chart-bar: #81A684;
  --chart-empty-border: #E7EDE2;
  --bg-chart-full: #FFFFFF;
  --heat-0: #F1EEE5;
  --heat-1: #D7E4D0;
  --heat-2: #A7C39A;
  --heat-3: #6B905F;
  --heat-4: #395A3D;
  --data-series-1: #B85D38;
  --data-series-2: #416B85;
}
