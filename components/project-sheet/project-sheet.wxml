<template name="inlineEditor">
  <view class="picker-inline-editor" id="picker-editor-{{editorId || 'root'}}">
    <view class="picker-field-label">{{editorLabel}}</view>
    <block wx:if="{{editorMode !== 'delete'}}">
      <input class="picker-name-input" value="{{newName}}" bindinput="inputName" maxlength="120" placeholder="输入项目名称" adjust-position confirm-type="done" bindconfirm="create" disabled="{{creating}}"/>
      <view class="picker-form-actions"><button class="picker-action-button picker-cancel" bindtap="cancelNew" disabled="{{creating}}">取消</button><button class="picker-action-button picker-create-entry {{creating ? 'is-disabled' : ''}}" bindtap="create" loading="{{creating}}" disabled="{{creating}}">{{editorMode === 'rename' ? '保存' : '添加'}}</button></view>
    </block>
    <block wx:else>
      <view class="picker-delete-message">{{deleteText}}</view>
      <view class="picker-form-actions"><button class="picker-action-button picker-cancel" bindtap="cancelNew" disabled="{{creating}}">取消</button><button class="picker-action-button picker-delete-confirm" bindtap="confirmDelete" loading="{{creating}}" disabled="{{creating}}">确认删除</button></view>
    </block>
  </view>
</template>
<view wx:if="{{opened}}" class="picker-overlay theme-{{theme}}" style="--picker-unit:{{pickerScale}}px;top:{{overlayTop}}px;bottom:{{overlayBottom}}px" catchtouchmove="noop">
  <view class="picker-mask" bindtap="close"></view>
  <view class="picker-card" style="height:{{cardHeight}}px">
    <view class="picker-head">
      <view class="picker-heading"><view class="picker-title">选择专注内容</view><view class="picker-subtitle">{{selectionName ? '当前：' + selectionName : '选择本次要专注的内容'}}</view></view>
      <view class="picker-close" bindtap="close" hover-class="picker-pressed" aria-role="button" aria-label="关闭选择"><view class="picker-close-icon"></view></view>
    </view>
    <view class="picker-top-actions"><button class="picker-new-project" bindtap="newProject" disabled="{{loading || creating}}">＋ 新建项目</button></view>
    <scroll-view scroll-y scroll-top="{{listScrollTop}}" class="picker-body" style="height:{{bodyHeight}}px" enhanced show-scrollbar="{{false}}">
      <template wx:if="{{newOpen && !editorId}}" is="inlineEditor" data="{{editorId, editorMode, editorLabel, newName, creating, deleteText}}"/>
      <view wx:if="{{recent.length}}" class="picker-recent-section">
        <view class="picker-section-title">最近使用</view>
        <view class="picker-recent">
          <view wx:for="{{recent}}" wx:key="projectId" data-id="{{item.projectId}}" bindtap="recentTap" hover-class="picker-pressed" class="picker-recent-item {{selected===item.projectId?'picker-recent-selected':''}}">
            <view class="picker-recent-top"><view class="picker-dot" style="background:{{item.color}}"></view><text class="picker-recent-name">{{item.name}}</text><view wx:if="{{selected===item.projectId}}" class="picker-check"></view></view>
            <view wx:if="{{item.parentLabel}}" class="picker-recent-path">{{item.parentLabel}}</view>
          </view>
        </view>
      </view>
      <view wx:if="{{rows.length}}" class="picker-section-heading"><text class="picker-section-title">全部项目</text><text class="picker-section-hint">三点菜单可添加或编辑</text></view>
      <view wx:if="{{loading}}" class="picker-message">正在读取…</view>
      <view wx:if="{{error}}" class="picker-message" bindtap="load">{{error}}<view class="picker-retry">点击重新读取</view></view>
      <view wx:for="{{rows}}" wx:key="projectId" id="picker-row-{{item.projectId}}" class="picker-row-group" style="margin-left:{{item.indent * pickerScale}}px">
        <view class="picker-row {{selected===item.projectId?'picker-row-selected':''}} {{item.depth?'picker-row-child':''}}">
          <block wx:if="{{item.depth}}">
            <view wx:for="{{item.guideRails}}" wx:for-item="rail" wx:key="left" class="picker-guide-rail" style="left:{{rail.left * pickerScale}}px"></view>
            <view wx:if="{{item.guideTop || item.guideBottom}}" class="picker-guide-stem {{item.guideTop && item.guideBottom ? 'picker-guide-stem-full' : item.guideTop ? 'picker-guide-stem-top' : 'picker-guide-stem-bottom'}}" style="left:{{item.guideLeft * pickerScale}}px"></view>
            <view class="picker-guide-branch" style="left:{{item.guideLeft * pickerScale}}px"></view>
          </block>
          <view class="picker-expand" data-id="{{item.projectId}}" catchtap="toggleExpand" aria-role="button" aria-label="展开或收起{{item.name}}"><view wx:if="{{item.childCount}}" class="picker-chevron {{item.expanded?'picker-chevron-open':''}}"></view></view>
          <view class="picker-row-main" data-id="{{item.projectId}}" bindtap="rowTap" hover-class="picker-row-pressed" aria-role="button" aria-label="{{item.startable ? '选择' : '展开'}}{{item.name}}"><view class="picker-dot" style="background:{{item.color}}"></view><text class="picker-row-name">{{item.name}}</text><text wx:if="{{createdId===item.projectId}}" class="picker-new-label">新建</text><view wx:if="{{selected===item.projectId}}" class="picker-check"></view></view>
          <view class="picker-more {{menuId === item.projectId ? 'picker-more-active' : ''}}" data-id="{{item.projectId}}" catchtap="toggleMenu" hover-class="picker-row-pressed" aria-role="button" aria-label="管理{{item.name}}"><view></view><view></view><view></view></view>
        </view>
        <view wx:if="{{menuId === item.projectId}}" class="picker-row-menu"><button class="picker-row-menu-button" data-id="{{item.projectId}}" bindtap="newProject" disabled="{{creating}}">＋ 添加项目</button><button class="picker-row-menu-button" data-id="{{item.projectId}}" bindtap="renameProject" disabled="{{creating}}">改名</button><button class="picker-row-menu-button picker-delete-entry" data-id="{{item.projectId}}" bindtap="askDelete" disabled="{{creating}}">删除</button></view>
        <template wx:if="{{newOpen && editorId === item.projectId}}" is="inlineEditor" data="{{editorId, editorMode, editorLabel, newName, creating, deleteText}}"/>
      </view>
      <view wx:if="{{!loading && !error && !rows.length}}" class="picker-empty"><view class="picker-empty-title">还没有项目</view><view>点击“新建项目”，添加你的专注内容</view></view>
    </scroll-view>
    <view class="picker-footer"><view class="picker-manage-entry" bindtap="goManage" hover-class="picker-pressed"><text class="picker-manage">更多管理</text><view class="picker-chevron"></view></view><button class="picker-footer-close" bindtap="close" disabled="{{creating}}">关闭</button></view>
  </view>
</view>
