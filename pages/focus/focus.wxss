.focus-layout{padding:0 18rpx;display:flex;flex-direction:column}
.focus-layout.with-tabbar{padding-bottom:calc(110rpx + env(safe-area-inset-bottom))}
.focus-stage{flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:24rpx 0 32rpx;box-sizing:border-box}
