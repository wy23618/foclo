:host{display:block}
.tree{padding-top:8rpx}
.tree-group+.tree-group{border-top:1rpx solid var(--divider);margin-top:12rpx;padding-top:12rpx}
.tree-row{display:flex;align-items:center;gap:10rpx;min-height:78rpx;padding:12rpx 6rpx;box-sizing:border-box;border-radius:18rpx}
.tree-row-selected{background:var(--bg-control-soft)}
.tree-row+.tree-row{border-top:1rpx solid var(--divider)}
.tree-child{min-height:72rpx;padding-left:16rpx;border-left:2rpx solid var(--border)}
.tree-main{display:flex;align-items:flex-start;gap:12rpx;min-width:0;flex:1}
.dot{width:15rpx;height:15rpx;margin-top:11rpx;border-radius:50%;flex-shrink:0}
.tree-child .dot{width:11rpx;height:11rpx}
.tree-copy{display:flex;flex-direction:column;gap:3rpx;min-width:0;flex:1}
.name{font-size:25rpx;line-height:1.35;font-weight:600;color:var(--text-primary);overflow-wrap:anywhere}
.tree-child .name{font-size:24rpx;font-weight:500}
.tree-meta{font-size:21rpx;color:var(--text-muted);font-variant-numeric:tabular-nums}
.tree-track{height:7rpx;margin-top:6rpx;border-radius:99rpx;background:var(--bg-control);overflow:hidden}
.tree-fill{height:100%;border-radius:99rpx}
.toggle{display:flex;align-items:center;justify-content:center;width:76rpx;height:76rpx;margin-right:-8rpx;flex-shrink:0;border-radius:20rpx;color:var(--accent)}
.toggle-pressed{background:var(--bg-control-soft)}
.chevron{width:12rpx;height:12rpx;border-right:2rpx solid var(--accent);border-bottom:2rpx solid var(--accent);transform:rotate(45deg);transition:transform .18s ease}
.chevron-open{transform:rotate(225deg)}
.go{display:flex;align-items:center;justify-content:center;gap:8rpx;min-width:76rpx;min-height:76rpx;box-sizing:border-box;padding:0 8rpx;flex-shrink:0;color:var(--accent);font-size:20rpx;font-weight:600}
.go-chevron{width:12rpx;height:12rpx;border-right:2rpx solid var(--text-muted);border-bottom:2rpx solid var(--text-muted);transform:rotate(-45deg)}
.archived{font-size:20rpx;font-weight:400;color:var(--text-muted)}
.row-pressed{opacity:.65}
