:host{display:block}
.detail{color:var(--text-primary);font-size:26rpx}
.detail-card{background:var(--bg-card);border:1rpx solid var(--border);border-radius:30rpx;padding:28rpx 30rpx;box-sizing:border-box;margin-bottom:24rpx}
.detail-card:last-child{margin-bottom:0}
.heading{display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:12rpx}
.date-nav{display:flex;align-items:center}
.date-title{font-size:26rpx;font-weight:600;font-variant-numeric:tabular-nums;padding:14rpx 0}
.arrow{min-width:50rpx;height:72rpx;display:flex;align-items:center;justify-content:center;font-size:34rpx;color:var(--accent)}
.disabled{color:var(--text-muted)}
.total{font-size:28rpx;font-weight:600}
.caption{font-size:22rpx;color:var(--text-secondary);margin-top:8rpx}
.section-title{font-size:28rpx;font-weight:700;color:var(--text-primary)}
.distribution{display:flex;align-items:center;gap:12rpx;padding:20rpx 0;font-size:24rpx;border-bottom:1rpx solid var(--divider)}
.distribution:last-child{border-bottom:0}
.dot{width:14rpx;height:14rpx;border-radius:100%;flex-shrink:0}
.name{flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.records-head{display:flex;align-items:center;justify-content:space-between;gap:18rpx;padding-bottom:22rpx;border-bottom:1rpx solid var(--divider)}
.records-summary{display:flex;align-items:center;justify-content:flex-end;gap:7rpx;flex-wrap:wrap;color:var(--text-muted);font-size:21rpx;text-align:right}
.records-summary-dot{color:var(--text-muted)}
.record{display:flex;align-items:flex-start;gap:18rpx;padding:24rpx 0 0}
.record-marker{width:16rpx;height:16rpx;margin-top:10rpx;border-radius:50%;flex-shrink:0;box-shadow:0 0 0 3rpx var(--bg-card)}
.record-body{flex:1;min-width:0;padding:0 0 24rpx;border-bottom:1rpx solid var(--divider)}
.record:last-of-type .record-body{border-bottom:0}
.record-primary{display:flex;align-items:baseline;justify-content:space-between;gap:18rpx}
.record-project{display:flex;align-items:center;min-width:0;flex:1}
.rec-name{font-size:27rpx;line-height:1.4;font-weight:700;color:var(--text-primary);overflow-wrap:anywhere}
.duration{font-size:26rpx;line-height:1.4;font-weight:750;color:var(--accent);white-space:nowrap;flex-shrink:0}
.record-secondary{display:flex;align-items:center;justify-content:space-between;gap:18rpx;margin-top:8rpx;color:var(--text-muted);font-size:22rpx}
.record-context{display:flex;align-items:center;gap:10rpx;min-width:0;flex:1}
.record-parent{min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.record-time{flex-shrink:0;font-variant-numeric:tabular-nums;white-space:nowrap}
.rec-status{flex-shrink:0;padding:2rpx 9rpx;border-radius:99rpx;background:var(--accent-soft);color:var(--accent);font-size:19rpx}
.empty{padding:42rpx 8rpx;text-align:center;color:var(--text-secondary);font-size:24rpx}
.empty-action{margin-top:20rpx;font-size:24rpx;color:var(--accent);background:var(--bg-control-soft);border-radius:18rpx}
.empty-action::after,.more::after{border:0}
.more{display:flex;align-items:center;justify-content:center;gap:12rpx;width:78%;margin:20rpx auto 0;padding:9rpx 0;background:var(--bg-control-soft);border-radius:999rpx;color:var(--accent);font-size:23rpx;font-weight:650}
.more-chevron{width:11rpx;height:11rpx;border-right:2rpx solid var(--accent);border-bottom:2rpx solid var(--accent);transform:rotate(45deg)}
.more-chevron-up{transform:rotate(225deg)}
