/* pages/picker/picker.wxss */

.picker-input { margin-bottom: 16rpx; }

.picker-parent { margin-bottom: 8rpx; }

.picker-hint { display: block; margin-bottom: 20rpx; }

.picker-empty { padding: 24rpx 0; }

.picker-row {
  display: flex;
  align-items: center;
  padding: 22rpx 16rpx;
  border-radius: 16rpx;
}

.picker-row:active { background: var(--bg-control-soft); }

.picker-main {
  flex: 1;
  display: flex;
  align-items: center;
  min-width: 0;
}

.picker-icon {
  margin-right: 12rpx;
  color: var(--text-muted);
}

.picker-setparent {
  flex-shrink: 0;
  margin-left: 16rpx;
  padding: 10rpx 20rpx;
  font-size: 22rpx;
  color: var(--accent);
  border: 1rpx solid var(--accent);
  border-radius: 999rpx;
}

.picker-setparent:active { background: var(--accent-soft); }
