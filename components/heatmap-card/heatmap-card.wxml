<view wx:if="{{opened}}" class="overlay {{landscapeLayout?'landscape-heatmap':''}} theme-{{theme}}" style="top:{{topInset}}px;{{standalone ? 'bottom:0;' : ''}}" catchtouchmove="noop">
  <view class="mask" bindtap="close" catchtouchmove="noop"></view>
  <view class="panel">
    <view class="head"><text class="title">学习热力图</text><view class="close" bindtap="close" hover-class="pressed">关闭</view></view>
    <view wx:if="{{!tabletLayout}}" class="body"><include src="./heatmap-body.wxml"/></view>
    <scroll-view wx:else class="body" scroll-y="{{true}}"><include src="./heatmap-body.wxml"/></scroll-view>
  </view>
  <view wx:if="{{scopePickerOpen}}" class="scope-picker-overlay">
    <view class="scope-picker-mask" bindtap="closeScopePicker" catchtouchmove="noop"></view>
    <view class="scope-dialog" catchtap="noop">
      <view class="scope-head"><text>选择统计范围</text><view class="scope-close" bindtap="closeScopePicker">×</view></view>
      <input class="scope-search" value="{{scopeQuery}}" bindinput="queryScopes" placeholder="搜索项目名称或路径" confirm-type="search" />
      <view wx:if="{{!scopeQuery && recentScopes.length}}" class="recent-scopes"><text class="scope-section-label">最近选择</text><view class="recent-list"><view wx:for="{{recentScopes}}" wx:key="id" class="recent-item {{scope===item.id?'recent-selected':''}}" data-id="{{item.id}}" bindtap="selectScope">{{item.id?item.name:'全部项目'}}</view></view></view>
      <view class="scope-section-label">{{scopeQuery?'搜索结果':'项目层级'}}</view>
      <scroll-view scroll-y class="scope-options" enhanced show-scrollbar="{{false}}">
        <view wx:if="{{scopeLoading}}" class="scope-empty">正在读取项目…</view>
        <view wx:elif="{{scopeError}}" class="scope-empty" bindtap="loadScopeOptions">{{scopeError}} · 点击重试</view>
        <block wx:else>
        <view wx:if="{{!scopeQuery}}" class="scope-row all-scope-row" data-id="" bindtap="selectScope"><view class="scope-row-main"><text class="scope-option-name">全部项目</text><text class="scope-check" wx:if="selectedScopeId===''">✓</text></view></view>
        <view wx:for="{{scopePickerRows}}" wx:key="id" class="tablet-inline scope-row {{item.archived?'scope-archived':''}}" style="--tablet-value-padding-left:calc({{item.searchMatch?0:item.depth*22}} * .6px);padding-left:var(--tablet-length-padding-left, {{item.searchMatch?0:item.depth*22}}rpx)">
          <view class="scope-row-main" data-id="{{item.id}}" bindtap="selectScope"><view class="scope-project-dot"></view><view class="scope-row-copy"><text class="scope-option-name">{{item.name}}</text><text wx:if="{{scopeQuery}}" class="scope-path">{{item.path}}</text></view><text wx:if="{{selectedScopeId===item.id}}" class="scope-check">✓</text></view>
          <view wx:if="{{!scopeQuery && item.hasChildren}}" class="scope-expand {{item.expanded?'scope-expanded':''}}" data-id="{{item.id}}" catchtap="toggleScopeBranch"><view class="scope-chevron"></view></view>
        </view>
        <view wx:if="{{scopeQuery && !scopePickerRows.length}}" class="scope-empty">没有找到匹配的项目</view>
        </block>
      </scroll-view>
      <view class="scope-picker-footer" bindtap="closeScopePicker">完成</view>
    </view>
  </view>
</view>
