.privacy-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 30rpx 28rpx calc(48rpx + env(safe-area-inset-bottom));
  background: var(--bg-page);
  color: var(--text-primary);
}
.policy-title { font-size: 34rpx; line-height: 1.5; font-weight: 650; letter-spacing: .2rpx; }
.policy-meta { margin-top: 12rpx; font-size: 24rpx; line-height: 1.7; color: var(--text-secondary); }
.policy-intro, .policy-paragraph, .row-copy, .policy-contact {
  font-size: 28rpx;
  line-height: 1.85;
  overflow-wrap: anywhere;
}
.policy-intro { margin-top: 24rpx; padding: 24rpx 26rpx; border-radius: 22rpx; background: var(--bg-note); color: var(--text-secondary); }
.policy-paragraph { margin-top: 16rpx; }
.policy-important { margin-top: 18rpx; padding: 20rpx 22rpx; border-radius: 18rpx; background: var(--accent-soft); color: var(--text-primary); font-weight: 600; }
.policy-section { margin-top: 22rpx; padding: 25rpx 26rpx; border: 1rpx solid var(--border); border-radius: 26rpx; background: var(--bg-card); box-shadow: 0 4rpx 16rpx rgba(61,90,64,.035); }
.section-title { font-size: 29rpx; line-height: 1.6; font-weight: 650; margin-bottom: 16rpx; color: var(--accent); }
.privacy-row { margin-top: 20rpx; }
.row-title { font-size: 28rpx; line-height: 1.7; font-weight: 500; }
.row-copy { margin-top: 5rpx; }
.policy-contact { margin-top: 16rpx; }
.policy-links {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx 24rpx;
  margin-top: 22rpx;
  padding: 12rpx 24rpx;
  border: 1rpx solid var(--border);
  border-radius: 22rpx;
  background: var(--bg-card);
}
button.policy-link {
  width: auto !important;
  min-height: 64rpx;
  margin: 0 !important;
  padding: 12rpx 16rpx !important;
  border-radius: 999rpx;
  background: var(--bg-control-soft);
  color: var(--accent);
  font-size: 26rpx;
  font-weight: 400;
  line-height: 1.5;
  text-align: left;
}
button.policy-link::after { border: 0; }
.link-pressed { background: var(--bg-control-soft); }
