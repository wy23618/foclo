.scope-switch { padding: 6rpx 0 20rpx; color: var(--accent); font-size: 28rpx; font-weight: 600; }
.month-nav { display: flex; align-items: center; }
.month-arrow { width: 72rpx; height: 72rpx; flex-shrink: 0; display: flex; align-items: center; justify-content: center; border-radius: 999rpx; background: var(--bg-control-soft); color: var(--accent); font-size: 40rpx; }
.month-arrow-off { color: var(--text-muted); background: transparent; }
.month-label { text-align: center; font-size: 34rpx; font-weight: 700; color: var(--text-primary); }
.month-summary { margin-top: 10rpx; }

.cal-head { display: flex; margin-bottom: 10rpx; }
.cal-head-cell { flex: 1; text-align: center; font-size: 22rpx; color: var(--text-muted); }
.cal-grid { display: flex; flex-direction: column; }
.cal-row { display: flex; }
.cal-row > view { flex: 1; display: flex; min-width: 0; }
.cal-cell { flex: 1; min-height: 78rpx; aspect-ratio: 1 / 1.18; margin: 5rpx; border-radius: 14rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; box-sizing: border-box; }
.cal-day { font-size: 22rpx; line-height: 1.3; color: var(--text-secondary); }
.cal-dur { margin-top: 4rpx; font-size: 20rpx; font-weight: 600; line-height: 1.2; white-space: nowrap; font-variant-numeric: tabular-nums; }
.cal-cell-today { border: 3rpx solid var(--accent); box-shadow: inset 0 0 0 2rpx var(--bg-card); }
.cal-cell-future { border: 2rpx dashed var(--border); background: transparent; }
.cal-cell-future .cal-day, .cal-cell-future .cal-dur { color: var(--text-muted); }
.cal-outside { border: 1rpx dashed var(--border); background: transparent; opacity: .45; }
.legend { display: flex; align-items: center; justify-content: center; gap: 10rpx; margin-top: 28rpx; }
.legend-gradient { width: 220rpx; height: 22rpx; border-radius: 999rpx; background: linear-gradient(to right, var(--heat-0), var(--heat-1), var(--heat-2), var(--heat-3), var(--heat-4)); }
.legend-hint { margin-top: 14rpx; text-align: center; display: block; }
