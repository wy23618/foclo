.privacy-page{min-height:100vh;box-sizing:border-box;padding:32rpx 28rpx calc(48rpx + env(safe-area-inset-bottom));background:var(--bg-page);color:var(--text-primary)}
.privacy-hero{padding:8rpx 7rpx 28rpx}.privacy-eyebrow{font-size:22rpx;letter-spacing:1rpx;color:var(--accent)}
.privacy-title{font-size:43rpx;line-height:1.35;font-weight:700;letter-spacing:-1rpx;margin-top:19rpx}.privacy-intro{font-size:24rpx;line-height:1.8;color:var(--text-secondary);margin-top:12rpx}
.privacy-notice{display:flex;gap:15rpx;padding:21rpx;border-radius:19rpx;background:var(--warning-bg);color:var(--text-secondary);font-size:22rpx;line-height:1.75;margin-bottom:19rpx}
.notice-mark{width:32rpx;height:32rpx;flex:none;display:flex;align-items:center;justify-content:center;border:2rpx solid var(--status-paused);border-radius:50%;color:var(--status-paused);font-weight:700;margin-top:2rpx;box-sizing:border-box}.notice-copy{flex:1}.notice-title{font-size:24rpx;color:var(--text-primary);font-weight:600;margin-bottom:4rpx}
.privacy-card{padding:0 24rpx;margin-bottom:18rpx;background:var(--bg-card);border:1rpx solid var(--border);border-radius:22rpx}.section-heading{display:flex;align-items:center;gap:13rpx;padding:23rpx 0 12rpx;border-bottom:1rpx solid var(--divider)}
.section-index{font-size:20rpx;color:var(--accent);font-variant-numeric:tabular-nums}.section-title{font-size:27rpx;font-weight:650}.privacy-row{padding:18rpx 0;border-bottom:1rpx solid var(--divider)}.privacy-row:last-child{border-bottom:0}
.row-title{font-size:24rpx;font-weight:600;line-height:1.5}.row-copy{font-size:23rpx;line-height:1.8;color:var(--text-secondary);margin-top:5rpx;overflow-wrap:anywhere}.privacy-footnote{padding:0 0 20rpx;font-size:21rpx;color:var(--text-secondary)}.privacy-card-last{margin-bottom:22rpx}
.privacy-actions{display:flex;flex-direction:column;gap:12rpx}button.primary-action,button.secondary-action{display:flex!important;align-items:center;justify-content:space-between;width:100%!important;margin:0!important;padding:23rpx 25rpx!important;border-radius:18rpx;line-height:1.5;font-size:24rpx;box-sizing:border-box}
.primary-action{background:var(--action-primary);color:var(--text-on-accent);font-weight:600}.secondary-action{background:var(--bg-control-soft);color:var(--text-primary);font-weight:500}.primary-action text,.secondary-action text{font-size:31rpx;line-height:1;color:var(--accent)}.primary-action text{color:var(--text-on-accent)}
button.primary-action::after,button.secondary-action::after{border:0}.action-pressed{opacity:.72}.privacy-footer{text-align:center;font-size:21rpx;line-height:1.7;color:var(--text-secondary);padding:21rpx 8rpx 0}
