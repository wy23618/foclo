[Unit]
Description=Check the private YoTick API readiness
After=yotick.service

[Service]
Type=oneshot
User=yotick
Group=yotick
ExecStart=/usr/bin/curl --fail --silent --show-error --max-time 5 http://127.0.0.1:3000/health/ready
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
TimeoutStartSec=10s
