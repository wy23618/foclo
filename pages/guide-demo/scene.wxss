.demo-loading{min-height:70vh;display:flex;align-items:center;justify-content:center;padding:48rpx;box-sizing:border-box;color:#757d73;font-size:26rpx;text-align:center;line-height:1.7}
.demo-loading-card{width:100%;max-width:560rpx;padding:56rpx 34rpx;border:1rpx solid rgba(128,111,126,.12);border-radius:32rpx;background:var(--bg-card,#fff);box-shadow:0 18rpx 50rpx rgba(54,39,52,.07);display:flex;flex-direction:column;align-items:center;box-sizing:border-box}
.demo-loader-mark{width:56rpx;height:56rpx;position:relative;margin-bottom:24rpx;display:flex;align-items:center;justify-content:center}
.demo-loader-orbit{width:48rpx;height:48rpx;border:4rpx solid rgba(158,119,150,.2);border-top-color:#9e7796;border-radius:50%;animation:demo-loading-spin .85s linear infinite;box-sizing:border-box}
.demo-loader-dot{width:8rpx;height:8rpx;border-radius:50%;background:#9e7796;position:absolute}
.demo-loading-title{font-size:29rpx;font-weight:600;color:var(--text-primary,#343039)}
.demo-loading-copy{margin-top:10rpx;font-size:23rpx;color:var(--text-secondary,#85818a)}
.demo-loading-back{margin-top:30rpx;padding:0 32rpx;height:72rpx;line-height:72rpx;border:0;border-radius:999rpx;background:#9e7796;color:#fff;font-size:24rpx}
.demo-loading-back::after{border:0}
.demo-loading-error .demo-loading-title{color:#704f67}
@keyframes demo-loading-spin{to{transform:rotate(360deg)}}
.demo-scroll-tail{height:65vh;pointer-events:none}
.demo-exit{position:fixed;z-index:550;right:24rpx;bottom:calc(20rpx + env(safe-area-inset-bottom));display:flex;align-items:center;gap:10rpx;padding:15rpx 22rpx;border:1rpx solid var(--border);border-radius:999rpx;background:var(--bg-card);color:var(--text-secondary);font-size:21rpx;line-height:1.4;box-shadow:0 3rpx 15rpx rgba(25,40,25,.06)}
.demo-exit-tabs{bottom:calc(118rpx + env(safe-area-inset-bottom))}.demo-exit-divider{color:var(--text-muted)}
/* tablet-generated:start */
