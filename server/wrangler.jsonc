{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "foclo-api",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-10-15",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "rules": [{"type":"Text","globs":["**/*.sql"],"fallthrough":true}],
  "durable_objects": {"bindings":[{"name":"FOCLO_DB","class_name":"FocloDatabase"}]},
  "migrations": [{"tag":"v1","new_sqlite_classes":["FocloDatabase"]}]
}
